@page "/codelookup"
@using Services
@using Data.Models
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.SplitButtons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Spinner

<PageTitle>UK Code Lookup</PageTitle>

<h3>UK Code Lookup</h3>

<div class="col-lg-12 control-section">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-xs-4 col-sm-4 col-lg-4 col-md-4">
                <SfTextBox CssClass="e-outline" @bind-Value="SearchString" Placeholder="Code" FloatLabelType="@FloatLabelType.Auto"></SfTextBox>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-4 col-sm-4 col-lg-4 col-md-4">
                <SfDatePicker CssClass="e-outline" TValue="DateTime" @bind-Value="DateValue" Placeholder="Choose a Month" Format="MMMM yyyy" Start="CalendarView.Year" Depth="CalendarView.Year" ShowClearButton="true" FullScreen="true"></SfDatePicker>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-4 col-sm-4 col-lg-4 col-md-4">
                <SfButton @ref="BtnSearch" @onclick="SearchData" CssClass="e-flat" IsPrimary="true" Content="Search"></SfButton>

                <SfDropDownButton Content="Data Type" CssClass="e-caret-hide">
                    <DropDownButtonEvents ItemSelected="ItemSelected">
                    </DropDownButtonEvents>
                    <DropDownMenuItems>
                        <DropDownMenuItem Text="Hs2Code"></DropDownMenuItem>
                        <DropDownMenuItem Text="Hs4Code"></DropDownMenuItem>
                        <DropDownMenuItem Text="Hs6Code"></DropDownMenuItem>
                        <DropDownMenuItem Text="Cn8Code"></DropDownMenuItem>
                    </DropDownMenuItems>
                </SfDropDownButton>
                <p style="color:blue">@SearchType</p>
            </div>
            <p style="color:red">@error</p>
        </div>
    </div>
    <SfGrid @ref="Grid"
            DataSource="@commodityDatas"
            TValue="CommodityDataModel"
            Toolbar="@toolBar"
            ShowColumnChooser="true"
            AllowPaging="true"
            AllowSorting="true"
            AllowFiltering="true"
            AllowExcelExport="true"
            AllowPdfExport="false"
            AllowSelection="true"
            AllowGrouping="true"
            Height="450"
            Width="Auto">
        <GridPageSettings PageCount="10" PageSize="15"></GridPageSettings>
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
        <GridPageSettings PageCount="10"></GridPageSettings>
        <GridEvents OnToolbarClick="ToolbarClickHandler" TValue="CommodityDataModel"></GridEvents>
        @*<GridEvents DataBound="OnChapterDataBound" RowSelected="GetSelectedChapterRecords" TValue="ChaptersModel"></GridEvents>*@
    <GridColumns>

        <GridColumn Field=@nameof(CommodityDataModel.Id) HeaderText="Id" IsPrimaryKey="true" Visible="true" TextAlign="TextAlign.Left" AutoFit="true" Width="120"></GridColumn>
        <GridColumn Field=@nameof(CommodityDataModel.Hs2Code) HeaderText="HS2" TextAlign="TextAlign.Left" AutoFit="true" AllowEditing="false" Type="Syncfusion.Blazor.Grids.ColumnType.String"></GridColumn>
        <GridColumn Field=@nameof(CommodityDataModel.Hs4Code) HeaderText="Hs4" TextAlign="TextAlign.Left" AutoFit="true" AllowEditing="false" Type="Syncfusion.Blazor.Grids.ColumnType.String"></GridColumn>
        <GridColumn Field=@nameof(CommodityDataModel.Hs6Code) HeaderText="Hs6" TextAlign="TextAlign.Left" AutoFit="true" AllowEditing="false" Type="Syncfusion.Blazor.Grids.ColumnType.String"></GridColumn>
        <GridColumn Field=@nameof(CommodityDataModel.Cn8Code) HeaderText="Cn8Code" TextAlign="TextAlign.Left" AutoFit="true" AllowEditing="false" Type="Syncfusion.Blazor.Grids.ColumnType.String"></GridColumn>
        <GridColumn Field=@nameof(CommodityDataModel.Cn8LongDescription) HeaderText="Description" TextAlign="TextAlign.Left" AutoFit="true" AllowEditing="false" Type="Syncfusion.Blazor.Grids.ColumnType.String"></GridColumn>
        @*<GridColumn Field=@nameof(CommodityDataModel.CommodityId) HeaderText="Commodity Id" TextAlign="TextAlign.Left" AutoFit="true" AllowEditing="false" Type="Syncfusion.Blazor.Grids.ColumnType.String"></GridColumn>*@
        <GridColumn Field=@nameof(CommodityDataModel.SitcCommodityCode) HeaderText="Sitc Commodity Code" TextAlign="TextAlign.Left" AutoFit="true" AllowEditing="false" Type="Syncfusion.Blazor.Grids.ColumnType.String"></GridColumn>
    </GridColumns>
        <SfSpinner @bind-Visible="IsLoading"></SfSpinner>
    </SfGrid>
</div>
@code {

    SfGrid<CommodityDataModel> Grid;
    SfButton BtnSearch;
    UKDataCommodityModel commodity { get; set; }
    public List<CommodityDataModel> commodityDatas = new List<CommodityDataModel>();

    public DateTime DateValue { get; set; } = DateTime.Now;
    string SearchString { get; set; } = string.Empty;
    string SearchType { get; set; } = string.Empty;
    bool IsLoading = false;
    private List<object> toolBar = new List<object> { "Search", "ExcelExport", "ColumnChooser" };
    string error { get; set; } = string.Empty;

    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Text == "Excel Export")
        {
            await Grid.ExportToExcelAsync();
        }
    }

    private void ItemSelected(MenuEventArgs args)
    {
        SearchType = args.Item.Text;
    }

    private async Task SearchData()
    {
        error = string.Empty;

        if (string.IsNullOrWhiteSpace(SearchString))
        {
            error = "Please enter a valid code.";
            return;
        }

        if (string.IsNullOrWhiteSpace(SearchType))
        {
            error = "Please enter a valid search Type.";
            return;
        }

        IsLoading = true;
        var tDataSrv = new TradeDataService();
        await tDataSrv.ClearImportTransactions();
        var apiService = ApiService.Instance;
        string dateSearch = DateValue.Year.ToString() + DateValue.Month.ToString().PadLeft(2, '0');

        //Cn8Code
        //Hs4Code
        //Hs6Code
        //Hs2Code


        commodityDatas.Clear();
        commodity = await apiService.GetUKCommodityData(SearchString, dateSearch, SearchType);
        int cnt = 1;
        foreach (var Item in commodity.data)
        {
            var model = new CommodityDataModel
            {
                Id = cnt,
                Cn8Code = Item.Cn8Code,
                Cn8LongDescription = Item.Cn8LongDescription,
                CommodityId = Item.CommodityId,
                Hs2Code = Item.Hs2Code,
                Hs2Description = Item.Hs2Description,
                Hs4Code = Item.Hs4Code,
                Hs4Description = Item.Hs4Description,
                Hs6Code = Item.Hs6Code,
                Hs6Description = Item.Hs6Description,
                SitcCommodityCode = Item.SitcCommodityCode
            };
            commodityDatas.Add(model);
            cnt++;
        }

        IsLoading = false;
        await Grid.Refresh();

    }

}

<style>
    .e-toast-container .e-toast .e-toast-message .e-toast-title {
        color: yellow;
        font-size: 18px;
        font-weight: bold;
    }

    .e-toast-container .e-toast {
        background-color: red;
    }

        .e-toast-container .e-toast .e-toast-message .e-toast-content {
            color: white;
            font-size: 13px;
            font-weight: normal;
        }
</style>