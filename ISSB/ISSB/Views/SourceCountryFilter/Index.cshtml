
@using Infragistics.Web.Mvc
@model IQueryable<Data.Models.SourceCountryFilterModel>
<!DOCTYPE html>
<html>
<head>
    <style>
        .optionContainer {
            display: inline-block;
        }

        .item {
            display: inline-block;
            height: 30px;
        }

            .item ~ .item {
                margin-left: 15px;
            }

        .item-label {
            display: block;
            float: right;
            margin-left: 5px;
            line-height: 21px;
        }

        .exporting-overlay {
            position: absolute;
            background-color: rgba(181, 181, 181, 0.9);
            top: 0;
            left: 0;
            z-index: 100000;
            text-align: center;
            vertical-align: top;
            padding-top: 100px;
        }

            .exporting-overlay:after {
                content: "";
                display: inline-block;
                vertical-align: middle;
                height: 100%;
            }

        .exporting-text {
            font-size: 46px;
            font-weight: bold;
            vertical-align: top;
        }
    </style>
</head>                                    
<body>
    <div class="content-header">
        <h2>@ViewData["Title"]</h2>
    </div>


    @{
        ViewData["Title"] = "Source Country Filters";
    }
<div>
    @(Html.Infragistics().Grid(Model)
                        .ID("grid")
                        .Width("100%")
                        .Height("600px")
                        .DataBind()
                        .PrimaryKey("_id")
                        .AutoGenerateColumns(false)
                        .AutoGenerateLayouts(false)
                        .Columns(column =>
                        {

                            column.For(x => x._id).HeaderText("Id").Width("10%").Hidden(true);
                            column.For(x => x.Name).HeaderText("Name").Width("50%");
                            column.For(x => x.Active).HeaderText("Active").Width("20%");
                            column.For(x => x.CanEdit).HeaderText("Locked").Width("20%");
                            column.For(x => x.SortOrder).HeaderText("Sort Order").Width("10%").Hidden(true);
                            column.For(x => x.Notes).HeaderText("Notes").Width("10%").Hidden(true);
                            column.For(x => x._id).HeaderText("").Width("7%").Template("<input type='button' onclick='editRow(\"${_id}\")' value='Edit' class='btn btn-block btn-warning btn-sm'/>");
                            column.For(x => x._id).HeaderText("").Width("7%").Template("<input type='button' onclick='deleteRow(\"${_id}\")' value='Delete' class='btn btn-block btn-danger btn-sm'/>");

                        })
                        .Features(features =>
                        {
                            features.Sorting().Type(OpType.Local).Mode(SortingMode.Multiple)
                            .ColumnSettings(setting =>
                            {
                                setting.ColumnSetting().ColumnKey("_id").AllowSorting(false);

                            });
                            features.Sorting().Type(OpType.Local)
                                .ColumnSettings(setting =>
                                {
                                    setting.ColumnSetting().ColumnKey("_id").AllowSorting(false);

                                });
                            features.Paging().Type(OpType.Local);
                            features.Filtering().Type(OpType.Local);
                            features.Selection().MultipleSelection(true);
                            features.RowSelectors().EnableRowNumbering(true);
                        })

                       .Render())  

    <hr />
        <div class="form-group row">
            <div class="col-md-5">
                <button id="addBtn" class="btn btn-outline-primary btn-md">Add Filter &nbsp;<span><i class="fas fa-folder-plus"></i></span></button>
                <button id="exportButton" class="btn btn-outline-success btn-md">Export to Excel &nbsp;<span><i class="fas fa-file-export"></i></span></button>
                @*<button id="pdfBtn" class="btn btn-outline-info btn-md">Export to PDF &nbsp;<span><i class="fas fa-file-pdf"></i></span></button>*@
            </div>                       
        </div>

    <script>$(function () {


        $("#exportButton").on("click", function () {
            var exportingOverlay = $('<div>');
            $.ig.GridExcelExporter.exportGrid($("#grid"), {
                columnsToSkip: ["_id"],
                fileName: "SourceCountryFilterData",
                worksheetName: "SourceCountryFilter",

                gridFeatureOptions: { sorting: "applied", filtering: "applied" },
            },
                {
                    exportStarting: function (e, args) {
                        showOverlay(args.grid, exportingOverlay);
                    },
                    success: function () {
                        hideOverlay(exportingOverlay);
                    },
                    cellExported: function (e, args) {
                        if (args.xlRow.index() == 0) {
                            return;
                        }

                    },
                    exportEnding: function (e, args) {
                        //args.worksheet.columns().item(2).cellFormat().formatString("dd-MM-yyyy");
                        //args.worksheet.columns().item(3).cellFormat().formatString("dd-MM-yyyy");
                    },
                });

        });



        $("#addBtn").on("click", function () {
            var url = "/SourceCountryFilter/Add";
            $(location).attr('href', url);
        });

        function showOverlay(grid, exportingOverlay) {
            var $gridContainer = $('#' + grid.attr('id') + '_container');

            exportingOverlay.css({
                "width": $gridContainer.outerWidth(),
                "height": $gridContainer.outerHeight()
            }).html('<span class="exporting-text">Exporting...</span>');
            exportingOverlay.addClass("exporting-overlay");

            $gridContainer.append(exportingOverlay);
        }
        function hideOverlay(exportingOverlay) {
            exportingOverlay.remove();
        }

        $("#pdfBtn").on("click", function () {
            window.location.href = 'SourceCountryFilter/PrintPage';
            return false;
        });

        });</script>

    <script>function editRow(rowId) {

        var url = "/SourceCountryFilter/Edit?_id=" + rowId.toString();
        $(location).attr('href', url);

    }

    function deleteRow(rowId) {
        var grid = $("#grid").data("igGrid");
        grid.dataSource.deleteRow(rowId);

        if (confirm('Do you want to delete?')) {
        }
        else {
            e.preventDefault()
            grid.commit();
        }

        var url = "/SourceCountryFilter/Delete?_id=" + rowId.toString();
        $(location).attr('href', url);
        };
    </script>

    <br />
    </div>
</body>
</html>
