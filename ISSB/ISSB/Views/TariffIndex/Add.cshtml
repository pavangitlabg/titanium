@model Data.Models.TariffIndexModel
@{

    ViewData["Title"] = "Add Tariff Region Index";

}

<body>
    <br />
    <div class="card sourceC">
        <div class="card-header">
            <h3>@ViewData["Title"]</h3>
        </div>

        <div class="container py-5">
            <div class="row">
                <div class="col-md-10 mx-auto">
                    @using (Html.BeginForm("AddNew", "TariffIndex"))
                    {
                        @Html.HiddenFor(x => x._id, new { _id = "_id" })
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="needs-validation">
                            <fieldset>
                                <div class="form-group row">
                                    <div class="col-sm-1">
                                        <label>@Html.LabelFor(u => u.Name, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-5 editor-field">
                                        @Html.TextBoxFor(u => u.Name, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(u => u.Name, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-sm-2 offset-sm-1">
                                        <label>@Html.LabelFor(u => u.Active, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-2 editor-field">
                                        @Html.DropDownListFor(u => u.Active, new List<SelectListItem> {
                                        new SelectListItem{Text="True", Value="true"},
                                        new SelectListItem{Text="False", Value="false"}}, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(u => u.Active, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-1">
                                        <label>@Html.LabelFor(u => u.Description, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-4 offset-sm-1 editor-field">
                                        @Html.TextAreaFor(u => u.Description, new { @class = "form-control", @rows = 2 })
                                        @Html.ValidationMessageFor(u => u.Description, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-sm-2 offset-sm-1">
                                        <label>@Html.LabelFor(u => u.Code, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-2 editor-field">
                                        @Html.TextBoxFor(u => u.Code, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(u => u.Code, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <hr />
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary px-4"><span>Save &nbsp;<i class="fas fa-file-import"></i></span></button>
                                </div>
                            </fieldset>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <br />
</body>