@using Infragistics.Web.Mvc
@model Data.Models.TradeDataModel
@{

    ViewData["Title"] = "Data Record";

}

<!DOCTYPE html>
<html>
<body>
    <div class="card">
        <div class="card-header">
            <h3>@ViewData["Title"]</h3>
        </div>
        @using (Html.BeginForm("Save", "DataExplorer"))
        {
            @Html.HiddenFor(x => x._id, new { _id = "_id" })
            <div class="form-horizontal">

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div style="width: 50%; margin-top:5%; margin-left:25%; margin-right:25%" class="needs-validation">
                    <fieldset>
                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.WEIGHT, htmlAttributes: new { @class = "control-label" })
                            </div>

                            <div class="editor-field">
                                @Html.EditorFor(u => u.WEIGHT, new { htmlAttributes = new { @class = "form-control", @type = "number", @min = "0", @step = "1", @value = "0" } })
                                @Html.ValidationMessageFor(u => u.WEIGHT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.MONETARY_VALUE, htmlAttributes: new { @class = "control-label" })
                            </div>

                            <div class="editor-field">

                                @Html.TextBoxFor(u => u.MONETARY_VALUE, htmlAttributes: new { @class = "form-control" })
                                @Html.ValidationMessageFor(u => u.MONETARY_VALUE, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.YTD_WEIGHT, htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class="editor-field">
                                @Html.TextBoxFor(u => u.YTD_WEIGHT, htmlAttributes: new { @class = "form-control" })
                                @Html.ValidationMessageFor(u => u.YTD_WEIGHT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.YTD_MONETARY_VALUE, htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class="editor-field">
                                @Html.TextBoxFor(u => u.YTD_MONETARY_VALUE, htmlAttributes: new { @class = "form-control" })
                                @Html.ValidationMessageFor(u => u.YTD_MONETARY_VALUE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <hr />
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary px-4"><span>Save &nbsp;<i class="fas fa-file-import"></i></span></button>
                        </div>
                    </fieldset>
                    <br />
                </div>
            </div>
        }
    </div>
</body>
</html>

