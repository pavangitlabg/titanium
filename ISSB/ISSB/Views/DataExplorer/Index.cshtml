@using Infragistics.Web.Mvc
@model Data.Models.TradeDataQueryModel
@{

    ViewData["Title"] = "Data Query";

}

<!DOCTYPE html>
<html>
<head>
</head>

<body>
    <div class="card">
        <div class="card-header">
            <div class="content-header">
                <h2>@ViewData["Title"]</h2>
                <hr />

                @using (Html.BeginForm("Execute", "DataExplorer"))
                {

                    <div class="form-horizontal">

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div style="width: 50%; margin-top:5%; margin-left:25%; margin-right:25%" class="needs-validation">
                            <fieldset>
                                <div class="form-group">
                                    <div class="editor-label">
                                        @Html.LabelFor(u => u.BatchNumber, htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="editor-field">
                                        @Html.EditorFor(u => u.BatchNumber, new { htmlAttributes = new { @class = "form-control", @type = "number" , id= "BatchNumber" } })
                                        @Html.ValidationMessageFor(u => u.BatchNumber, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <hr />
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary px-4"><span>Run Query &nbsp;<i class="fas fa-file-import"></i></span></button>
                                </div>

                            </fieldset>
                            <br />
                        </div>
                    </div>
                }
              
                        <button id="exportEUROFER" class="btn btn-outline-primary btn-md">Export To EUROFER &nbsp;<span><i class="fas fa-file-export"></i></span></button>
                        <button id="exportGTT" class="btn btn-outline-success btn-md">Export to GTT &nbsp;<span><i class="fas fa-file-export"></i></span></button>
                    
            </div>
        </div>
    </div>

    <script>

        $("#exportEUROFER").click(function () {
          
            var url = "/DataExplorer/ExportEurofer?ID=" + $('#BatchNumber').val();
            $(location).attr('href', url);

        });


        $("#exportGTT").click(function () {
           
            var url = "/DataExplorer/ExportGTT?ID=" + $('#BatchNumber').val();
            $(location).attr('href', url);
        });
    </script>

</body>
</html>

