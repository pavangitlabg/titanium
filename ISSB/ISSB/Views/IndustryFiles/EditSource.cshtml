@using Infragistics.Web.Mvc
@model Data.Models.FileUploadTypesModel
@{ ViewData["Title"] = "Edit Source"; }

<!DOCTYPE html>
<html>
<head>
    <style>
        p {
            font-size: 12px;
        }

        .red {
            color: red;
        }

        .blue {
            color: blue;
        }
    </style>
</head>

<body>
    <div class="card">
        <div class="card-header">
            <div class="content-header">
                <h2>@ViewData["Title"]</h2>
                <h3 class="red">@ViewData["Message"]</h3>
                <hr />
                <div class="container py-5">
                    <form method="post" enctype="multipart/form-data" asp-controller="IndustryFiles" asp-action="EditSaveSourceRows">
                        @Html.HiddenFor(x => x._id, new { _id = "_id" })
                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.Number, htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class="editor-field">

                                @Html.TextBoxFor(u => u.Number, new { @class = "form-control", @type = "number" })
                                @Html.ValidationMessageFor(u => u.Number, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.Description, htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class="editor-field">

                                @Html.TextBoxFor(u => u.Description, new { @class = "form-control" })
                                @Html.ValidationMessageFor(u => u.Description, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <hr />
                        <div class="form-group row">
                            <div class="col-md-10">
                                <button type="submit" class="btn btn-outline-primary btn-md">Save &nbsp;<span><i class="fas fa-file-upload"></i></span></button>
                            </div>
                        </div>
                    </form>


                </div>
            </div>
        </div>
    </div>
</body>
</html>

