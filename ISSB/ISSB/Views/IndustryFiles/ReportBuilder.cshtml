@using Infragistics.Web.Mvc
@model ISSB.Models.IndReportBuilterModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Industry Report Builder";
}


<div class="content-header">
    <h2>@ViewData["Title"]</h2>
    <h3>@ViewData["Message"]</h3>
</div>

<head>
    <script src="../js/IndQuery.js" type="text/javascript"></script>
    <style>
        #overlay {
            position: fixed;
            display: none;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.5);
            z-index: 2;
            cursor: pointer;
        }

        .optionContainer {
            display: inline-block;
        }

        .item {
            display: inline-block;
            height: 30px;
        }

            .item ~ .item {
                margin-left: 15px;
            }

        .item-label {
            display: block;
            float: right;
            margin-left: 5px;
            line-height: 21px;
        }

        .exporting-overlay {
            position: absolute;
            background-color: rgba(181, 181, 181, 0.9);
            top: 0;
            left: 0;
            z-index: 100000;
            text-align: center;
            vertical-align: top;
            padding-top: 100px;
        }

            .exporting-overlay:after {
                content: "";
                display: inline-block;
                vertical-align: middle;
                height: 100%;
            }

        .exporting-text {
            font-size: 46px;
            font-weight: bold;
            vertical-align: top;
        }
    </style>

</head>

<body>
    <input type="hidden" value="@Url.Action("ReportOutput", "IndustryFiles")" id="UrlRunReport" />
    <input type="hidden" value=@Model.ReportType id="ReportType" />
    <input type="hidden" value="@ViewBag.FormNumbers" id="FormNumbers" />
    <input type="hidden" value="@ViewBag.RowCodes" id="RowCodes" />
    <input type="hidden" value="@ViewBag.ColsList" id="ColsList" />
    <input type="hidden" value="@ViewBag.ProductType" id="ProductType" />
    <input type="hidden" value="@ViewBag.MedumSelectTreeData" id="MedumSelectTreeData" />
    <input type="hidden" value="@ViewBag.ReportType" id="ReportType" />
    <input type="hidden" value="@ViewBag.CanExecute" id="CanExecute" />

    <div class="container py-5">
        <div class="row">
            <div class="col-md-10 mx-auto">

                <div class="form-group row">

                </div>

                <div class="form-group row">
                    <div class="card card-secondary" id="C1">
                        <div class="card-header">
                            <header id="labSpecificProduct"> Form Numbers</header>
                            <div class="card-tools">
                                <button type="button" class="btn btn-tool" data-widget="collapse">
                                    <i class="fas fa-minus"></i>
                                </button>
                            </div>
                        </div>

                        @(Html.Infragistics().Grid(Model.Forms.AsQueryable())
                                            .ID("SourceForms")
                                            .Width("100%")
                                            .Height("300px")
                                            .DataBind()

                                            .AutoCommit(true)
                                            .PrimaryKey("Index")
                                                    .AutoGenerateColumns(false)
                                                    .AutoGenerateLayouts(false)
                                                    .Columns(column =>
                                                    {
                                                        column.For(x => x.Index).HeaderText("Index").Width("10%").Hidden(true);
                                                        column.For(x => x.FormNumber).HeaderText("Form Number").Width("20%");
                                                        column.For(x => x.Number).HeaderText("Source Number").Width("20%");
                                                        column.For(x => x.Name).HeaderText("Name").Width("70%");

                                                    })
                                            .Features(features =>
                                            {
                                                features.Sorting().Type(OpType.Local);
                                                features.Filtering().Type(OpType.Local);
                                                features.RowSelectors().EnableCheckBoxes(true);
                                                features.Selection().MultipleSelection(true);
                                                //features.Selection().Mode(SelectionMode.Row);

                                            })
                                            .Render())


                    </div>

                </div>

                <div class="form-group row">
                    <div class="card-body">
                        @if (Model.ReportType == 0)
                        {
                            //Start
                            <div class="card card-secondary" id="C2">
                                <div class="card-header">
                                    <header id="labProductLevel"> Product Level Selection</header>
                                    <div class="card-tools">
                                        <button type="button" class="btn btn-tool" data-widget="collapse">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="card-body">
                                    <div class="form-group">
                                        <form id="ProductTypeForm">
                                            <div class="form-row">
                                                <div class="form-group col-md-4">
                                                    <label class="radio-inline RadioButtonText" onclick="indbuilder.BroadProduct()">
                                                        <input type="radio" id="rdBroadProduct" name="radioName" value="Broad">&nbsp Broad Product
                                                    </label>
                                                </div>
                                                <div class="form-group col-md-4">
                                                    <label class="radio-inline RadioButtonText" onclick="indbuilder.MedumProduct()">
                                                        <input type="radio" id="rdMedumProduct" name="radioName" value="Medum">&nbsp Medium Level Product Detail (2 Digits)
                                                    </label>
                                                </div>
                                                <div class="form-group col-md-4">
                                                    <label class="radio-inline RadioButtonText" onclick="indbuilder.HighProduct()">
                                                        <input type="radio" id="rdHighLevelProduct" name="radioName" value="High">&nbsp High Level Product Detail
                                                    </label>
                                                </div>

                                                <div class="form-group col-md-4">
                                                    <label class="radio-inline RadioButtonText" onclick="indbuilder.LongProduct()">
                                                        <input type="radio" id="rdLongProduct" name="radioName" value="Long">&nbsp Full Product Detail
                                                    </label>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div class="card card-secondary" id="C3">
                                <div class="card-header">
                                    <header id="labSpecificProduct"> Specific Product Selection</header>
                                    <div class="card-tools">
                                        <button type="button" class="btn btn-tool" data-widget="collapse">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body">
                                    @(Html.Infragistics().Tree()
                                            .ID("broadtree")
                                            .Width("100%")
                                            .Height("280px")
                                            .DataSource(@ViewData["BroadTreeData"])
                                            .CheckboxMode(CheckboxMode.TriState)
                                            .SingleBranchExpand(true)
                                            .DragAndDrop(false)
                                            .DragAndDropSettings(d =>
                                            {
                                                d.DragAndDropMode(DragAndDropMode.Move);
                                                        //d.Revert(true);
                                                        d.CustomDropValidation("customDropValidation");
                                            })
                                            .PathSeparator('.')
                                            .Bindings(b =>
                                            b.PrimaryKey("Idx")
                                            .TextKey("Name")
                                            .ValueKey("Name")
                                            .ChildDataProperty("Items")
                                            .Bindings(b2 =>
                                            b2.TextKey("Description")
                                            .ValueKey("Idx")
                                            )
                                    )
                                    .DataBind()
                                    .Render()
                        )
                                    @(Html.Infragistics().Tree()
                                        .ID("medumtree")
                                        .Width("100%")
                                        .Height("280px")
                                        .DataSource(@ViewData["MedumTreeData"])
                                        .CheckboxMode(CheckboxMode.TriState)
                                        .SingleBranchExpand(true)
                                        .DragAndDrop(false)
                                        .DragAndDropSettings(d =>
                                        {
                                            d.DragAndDropMode(DragAndDropMode.Move);
                                                    //d.Revert(true);
                                            d.CustomDropValidation("customDropValidation");
                                        })
                                        .PathSeparator('.')

                                        .Bindings(b =>
                                        b.PrimaryKey("Idx")
                                        .TextKey("Name")
                                        .ValueKey("Name")
                                        .ChildDataProperty("Items")
                                        .Bindings(b2 =>
                                        b2.TextKey("Description")
                                        .ValueKey("Idx")
                                        )
                                )

                                .DataBind()
                                .Render()
                         )
                                    <div id="HighTreeDiv">
                                        @(Html.Infragistics().Grid(Model.HighTree.AsQueryable())
                                .ID("HighTree")
                                .Width("100%")
                                .Height("300px")
                                .DataBind()
                                .PrimaryKey("TariffCode")
                                        .AutoGenerateColumns(false)
                                        .AutoGenerateLayouts(false)
                                        .Columns(column =>
                                        {
                                            column.For(x => x.TariffCode).HeaderText("Tariff").Width("20%");
                                            column.For(x => x.Description).HeaderText("Description").Width("80%");
                                            // column.For(x => x.Name).HeaderText("Name").Width("60%");
                                        })
                                .Features(features =>
                                {
                                    features.Sorting().Type(OpType.Local);
                                    features.Filtering().Type(OpType.Local);
                                    features.RowSelectors().EnableCheckBoxes(true);
                                    features.Selection().MultipleSelection(true);
                                })
                                .Render())
                                    </div>
                                    <div id="LongTreeDiv">


                                        @(Html.Infragistics().Grid(Model.TariffCodes.AsQueryable())
                                            .ID("LongTree")
                                            .Width("100%")
                                            .Height("300px")
                                            .DataBind()

                                            .AutoCommit(true)
                                            .PrimaryKey("TrariffCode")
                                                    .AutoGenerateColumns(false)
                                                    .AutoGenerateLayouts(false)
                                                    .Columns(column =>
                                                    {
                                                        column.For(x => x.Index).HeaderText("Index").Width("10%").Hidden(true);
                                                        column.For(x => x.TrariffCode).HeaderText("Code").Width("20%");
                                                        column.For(x => x.Description).HeaderText("Description").Width("70%");

                                                    })
                                            .Features(features =>
                                            {
                                                features.Sorting().Type(OpType.Local);
                                                features.Filtering().Type(OpType.Local);
                                                features.RowSelectors().EnableCheckBoxes(true);
                                                features.Selection().MultipleSelection(true);
                                                //features.Selection().Mode(SelectionMode.Row);

                                            })
                                            .Render())
                                    </div>
                                </div>

                            </div>

                            //End
                        }
                        @if (Model.ReportType == 1)
                        {
                            <div class="form-group row">
                                <div class="card card-secondary" id="C4">
                                    <div class="card-header">
                                        <header id="labSpecificProduct"> Codes</header>
                                        <div class="card-tools">
                                            <button type="button" class="btn btn-tool" data-widget="collapse">
                                                <i class="fas fa-minus"></i>
                                            </button>
                                        </div>
                                    </div>

                                    @(Html.Infragistics().Grid(Model.DataRows.AsQueryable())
                                                    .ID("SourceCode")
                                                    .Width("100%")
                                                    .Height("300px")
                                                    .DataBind()

                                                    .AutoCommit(true)
                                                    .PrimaryKey("Index")
                                                            .AutoGenerateColumns(false)
                                                            .AutoGenerateLayouts(false)
                                                            .Columns(column =>
                                                            {
                                                                column.For(x => x.Index).HeaderText("Index").Width("10%").Hidden(true);
                                                                column.For(x => x.Number).HeaderText("Code").Width("20%");
                                                                column.For(x => x.Description).HeaderText("Description").Width("70%");

                                                            })
                                                    .Features(features =>
                                                    {
                                                        features.Sorting().Type(OpType.Local);
                                                        features.Filtering().Type(OpType.Local);
                                                        features.RowSelectors().EnableCheckBoxes(true);
                                                        features.Selection().MultipleSelection(true);
                                                        //features.Selection().Mode(SelectionMode.Row);

                                                    })
                                                    .Render())
                                </div>
                            </div>
                        }

                        <div class="form-group row">
                            <div class="card card-secondary" id="C5">
                                <div class="card-header">
                                    <header id="labSpecificProduct"> Column Codes</header>
                                    <div class="card-tools">
                                        <button type="button" class="btn btn-tool" data-widget="collapse">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                    </div>
                                </div>

                                @(Html.Infragistics().Grid(Model.Cols.AsQueryable())
                                            .ID("SourceCols")
                                            .Width("100%")
                                            .Height("300px")
                                            .DataBind()

                                            .AutoCommit(true)
                                            .PrimaryKey("Index")
                                                    .AutoGenerateColumns(false)
                                                    .AutoGenerateLayouts(false)
                                                    .Columns(column =>
                                                    {
                                                        column.For(x => x.Index).HeaderText("Index").Width("10%").Hidden(true);
                                                        column.For(x => x.Number).HeaderText("Column Number").Width("20%");
                                                        column.For(x => x.Name).HeaderText("Name").Width("70%");

                                                    })
                                            .Features(features =>
                                            {
                                                features.Sorting().Type(OpType.Local);
                                                features.Filtering().Type(OpType.Local);
                                                features.RowSelectors().EnableCheckBoxes(true);
                                                features.Selection().MultipleSelection(true);
                                                //features.Selection().Mode(SelectionMode.Row);

                                            })
                                            .Render())
                            </div>

                        </div>

                        <div class="form-row">

                            <div class="card card-secondary" id="C6">
                                <div class="card-header">
                                    <header id="labSpecificProduct"> Select Months</header>
                                    <div class="card-tools">
                                        <button type="button" class="btn btn-tool" data-widget="collapse">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                    </div>
                                </div>

                                @*<div id="cbMonths"></div>*@
                                <div class="btn-group" role="group" aria-label="Qselection">
                                    <button type="button" class="btn btn-default" onclick="indbuilder.SetQ1()">Q1</button>
                                    <button type="button" class="btn btn-default" onclick="indbuilder.SetQ2()">Q2</button>
                                    <button type="button" class="btn btn-default" onclick="indbuilder.SetQ3()">Q3</button>
                                    <button type="button" class="btn btn-default" onclick="indbuilder.SetQ4()">Q4</button>
                                    <button type="button" class="btn btn-default" onclick="indbuilder.SetAll()">All</button>
                                    <button type="button" class="btn btn-default" onclick="indbuilder.ClearAll()">Clear All</button>
                                </div>


                                <div class="form-group span3 offset2">

                                    <div>
                                        @(Html.Infragistics().Grid(Model.Years.AsQueryable())
                                            .ID("YearTable")
                                            .Width("100%")
                                            //.Height("auto")
                                            .RenderCheckboxes(true)
                                            .DataBind()
                                            .PrimaryKey("Id")
                                            .AutoGenerateColumns(false)
                                            .AutoGenerateLayouts(false)
                                            .Columns(column =>
                                            {
                                                column.For(x => x.Id).HeaderText("Id").Width("20%").Hidden(true);
                                                column.For(x => x.Year).HeaderText("Year").Width("20%");
                                                column.For(x => x.January)
                                                                .HeaderText("Jan")
                                                                .Width("10%")
                                                                .DataType("bool")
                                                                .Format("checkbox")
                                                                .Template("<input type='checkbox' />");

                                                column.For(x => x.February).HeaderText("Feb")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");
                                                column.For(x => x.March).HeaderText("Mar")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");
                                                column.For(x => x.April).HeaderText("Apr")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");
                                                column.For(x => x.May).HeaderText("May")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");
                                                column.For(x => x.June).HeaderText("Jun")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");
                                                column.For(x => x.July).HeaderText("Jul")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");
                                                column.For(x => x.August).HeaderText("Aug")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");
                                                column.For(x => x.September).HeaderText("Sep")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");
                                                column.For(x => x.October).HeaderText("Oct")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");
                                                column.For(x => x.November).HeaderText("Nov")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");
                                                column.For(x => x.December).HeaderText("Dec")
                                                                .Width("10%").DataType("bool").Format("checkbox").Template("<input type='checkbox' />");

                                            })
                                            .Features(features =>
                                            {

                                                //features.Sorting().Type(OpType.Local);
                                                // features.Filtering().Type(OpType.Local);
                                                // features.Updating();
                                                features.RowSelectors().EnableCheckBoxes(true);
                                                features.Selection().MultipleSelection(true);
                                            })
                                            //.AutoCommit(true)
                                            .Render())
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor(u => u.SaveReport, htmlAttributes: new { @class = "control-label" })
                    </div>
                    <div class="editor-field">
                        @Html.CheckBoxFor(u => u.SaveReport, htmlAttributes: new { @class = "checkbox", Id = "SaveReport" })
                        @Html.ValidationMessageFor(u => u.SaveReport, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor(u => u.ReportName, htmlAttributes: new { @class = "control-label" })
                    </div>

                    <div class="editor-field">

                        @Html.TextBoxFor(u => u.ReportName, htmlAttributes: new { @class = "form-control", Id = "ReportName" })
                        @Html.ValidationMessageFor(u => u.ReportName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <button id="storeSaveBtn" class="btn btn-outline-primary btn-sm" onclick="indbuilder.RunQuery()">Run Query</button>
                    <div id="error_message" style=" color: red;font-weight: bold"></div>
                    <div id="overlay">
                        <div id="text">Updating Data ......</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>