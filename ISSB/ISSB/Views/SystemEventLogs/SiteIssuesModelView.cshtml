@using Infragistics.Web.Mvc
@model Data.Models.SiteIssuesModel

@{

    ViewData["Title"] = "Site Issues View";

}

<body>
    <br />
    <div class="card">
        <div class="card-header">
            <h3>@ViewData["Title"]</h3>
        </div>

        <div class="container py-5">
            <div class="row">
                <div class="col-md-10 mx-auto">

                    @using (Html.BeginForm("Index", "SystemEventLogs"))
                    {
                        @Html.HiddenFor(x => x._id, new { id = "Id" })

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="needs-validation">
                            <fieldset>
                                <div class="form-group row">
                                    <div class="col-sm-4">
                                        <label>@Html.LabelFor(u => u.Timestamp, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="Timestamp" ; class="editor-field">
                                            @Html.EditorFor(u => u.Timestamp, new { htmlAttributes = new { @class = "form-control datepicker", @readonly = "readonly" } })
                                            @Html.ValidationMessageFor(u => u.Timestamp, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <label>@Html.LabelFor(u => u.Status, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="Status" ; class="editor-field">
                                            @Html.DropDownListFor(u => u.Status, new List<SelectListItem> {
                                            new SelectListItem{Text="Open", Value="Open"},
                                            new SelectListItem{Text="Closed", Value="Closed"}}, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.Status, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <label>@Html.LabelFor(u => u.Severity, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="Severity" ; class="editor-field">
                                            @Html.DropDownListFor(u => u.Severity, new List<SelectListItem> {
                                            new SelectListItem{Text="Critical", Value="Critical"},
                                            new SelectListItem{Text="Major", Value="Major"},
                                            new SelectListItem{Text="Minor", Value="Minor"},
                                            new SelectListItem{Text="Trivial", Value="Trivial"}}, "Select", new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.Status, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <br />
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label>@Html.LabelFor(u => u.User, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="User" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.User, "", new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.User, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <label>@Html.LabelFor(u => u.Email, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="Email" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.Email, htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.Email, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label>@Html.LabelFor(u => u.Subject, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="Subject" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.Subject, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.Subject, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <label>@Html.LabelFor(u => u.Description, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="Description" ; class="editor-field">
                                            @Html.TextAreaFor(u => u.Description, new { @class = "form-control", @rows = 5 })
                                            @Html.ValidationMessageFor(u => u.Description, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="form-group row">
                                    <div class="col-sm-12">
                                        <label>@Html.LabelFor(u => u.Comment, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="Comment" ; class="editor-field">
                                            @Html.TextAreaFor(u => u.Comment, htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.Comment, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="form-group">
                                    <button onclick="goBack()" class="btn btn-primary px-4"><span>Close &nbsp;<i class="far fa-times-circle"></i></span></button>
                                </div>
                            </fieldset>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <br />
</body>
