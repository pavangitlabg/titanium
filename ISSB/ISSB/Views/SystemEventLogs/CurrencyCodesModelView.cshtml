@using Infragistics.Web.Mvc
@model Data.Models.CurrencyCodesModel

@{

    ViewData["Title"] = "Currency Codes View";

}

<body>
    <br />
    <div class="card">
        <div class="card-header">
            <h3>@ViewData["Title"]</h3>
        </div>

        <div class="container py-5">
            <div class="row">
                <div class="col-md-10 mx-auto">

                    @using (Html.BeginForm("Index", "SystemEventLogs"))
                    {
                        @Html.HiddenFor(x => x._id, new { id = "Id" })
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="needs-validation">
                            <fieldset>
                                <div class="form-group row">
                                    <div class="col-sm-2">
                                        <label>@Html.LabelFor(u => u.CURRENCY_CODE, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-10">
                                        <div class="editor-field">
                                            @Html.EditorFor(u => u.CURRENCY_CODE, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(u => u.CURRENCY_CODE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-2">
                                        <label>@Html.LabelFor(u => u.CURRENCY_NAME, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-10">
                                        <div class="editor-field">
                                            @Html.EditorFor(u => u.CURRENCY_NAME, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(u => u.CURRENCY_NAME, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-2">
                                        <label>@Html.LabelFor(u => u.CURRENCY_SYMBOL, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-10">
                                        <div class="editor-field">
                                            @Html.EditorFor(u => u.CURRENCY_SYMBOL, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(u => u.CURRENCY_SYMBOL, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="form-group">
                                    <button onclick="goBack()" class="btn btn-primary px-4"><span>Close &nbsp;<i class="far fa-times-circle"></i></span></button>
                                </div>
                            </fieldset>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <br />
</body>
