@model Data.Models.EmailCredentialsModel
@{

    ViewData["Title"] = "Email Settings View";
    
}

<div class="card">
    <div class="card-header">
        <h2>@ViewData["Title"]</h2>
    </div>
    <h3>@ViewData["Message"]</h3>

    @if (User.Identity.IsAuthenticated)
    {

        @using (Html.BeginForm("Index", "SystemEventLogs"))
        {
        
            <div class="form-horizontal">
          
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div style="width: 50%; margin-top:5%; margin-left:25%; margin-right:25%" class="needs-validation">
                    <fieldset>
                        <div class="form-group">

                            <div class="editor-label">
                                @Html.LabelFor(u => u.EmailAddress, htmlAttributes: new { @class = "control-label " })
                            </div>

                            <div class="editor-field">
                                @Html.TextBoxFor(u => u.EmailAddress, new { @class = "form-control", id = "EmailAddress" })

                                @Html.ValidationMessageFor(u => u.EmailAddress, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.EmailPassword, htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class="editor-field">
                                @Html.PasswordFor(u => u.EmailPassword, new { @class = "form-control", id = "EmailPassword" })
                                @Html.ValidationMessageFor(u => u.EmailPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.FilePath, htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class="editor-field">
                                @Html.TextBoxFor(u => u.FilePath, new { @class = "form-control", id = "FilePath" })
                                @Html.ValidationMessageFor(u => u.FilePath, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <hr />
                        <div class="form-group">
                            <button onclick="goBack()" class="btn btn-primary px-4"><span>Close &nbsp;<i class="far fa-times-circle"></i></span></button>
                        </div>
                    </fieldset>
                    <br />
                </div>
            </div>
            }

        }
</div>
