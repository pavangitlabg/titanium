@using Infragistics.Web.Mvc
@model ISSB.Models.DataFileUploadModel
@{

    ViewData["Title"] = "Upload File";

}

<!DOCTYPE html>
<html>
<head>
    <style>


        p {
            font-size: 12px;
        }

        .red {
            color: red;
        }

        .blue {
            color: blue;
        }
    </style>
</head>

<body>
    <div class="card">
        <div class="card-header">
            <div class="content-header">
                <h2>@ViewData["Title"]</h2>
                <h3 class="red">@ViewData["Message"]</h3>
                <hr />
                <div class="container py-5">
                    <form method="post" enctype="multipart/form-data" asp-controller="DataImport" asp-action="Save">

                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.Source, htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class="editor-field">

                                @Html.TextBoxFor(u => u.Source, new { @class = "form-control", @readonly = "readonly" })
                                @Html.ValidationMessageFor(u => u.Source, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.Subject, htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class="editor-field">

                                @Html.TextBoxFor(u => u.Subject, new { @class = "form-control" })
                                @Html.ValidationMessageFor(u => u.Subject, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">

                            <div class="custom-file">

                                <input asp-for="File" class="form-control custom-file-input" />
                                <label class="custom-file-label">Choose File</label>
                            </div>

                        </div>

                        <hr />
                        <div class="form-group row">
                            <div class="col-md-10">
                                <button type="submit" class="btn btn-outline-primary btn-md">Upload File &nbsp;<span><i class="fas fa-file-upload"></i></span></button>
                            </div>
                        </div>
                    </form>


                </div>
            </div>
        </div>
    </div>
    <script>$(document).ready(function () {

            $('.custom-file-input').on("change", function () {
                var fileName = $(this).val().split("\\").pop();
                $(this).next('.custom-file-label').html(fileName);

            });

        });</script>

</body>
</html>

