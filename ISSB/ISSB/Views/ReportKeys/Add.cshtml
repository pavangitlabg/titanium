@using Infragistics.Web.Mvc
@model Data.Models.ReportKeysModel

@{

    ViewData["Title"] = "Add Report Keys";

}

<body>
    <br />
    <div class="card">
        <div class="card-header">
            <h3>@ViewData["Title"]</h3>
        </div>

        <div class="container py-5">
            <div class="row">
                <div class="col-md-10 mx-auto">

                    @using (Html.BeginForm("AddNew", "ReportKeys"))
                    {
                        @Html.HiddenFor(x => x._id, new { id = "Id" })

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="needs-validation">
                            <fieldset>
                                <div class="form-group row">
                                    <div class="col-sm-1">
                                        <label>@Html.LabelFor(u => u.Key, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="editor-field">
                                            @Html.EditorFor(u => u.Key, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(u => u.Key, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-1 offset-sm-2">
                                        <label>@Html.LabelFor(u => u.IsSelected, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="editor-field">
                                            @Html.CheckBoxFor(u => u.IsSelected, "false")
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-1">
                                        <label>@Html.LabelFor(u => u.Width, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="editor-field">
                                            @Html.EditorFor(u => u.Width, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(u => u.Width, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-sm-1 offset-sm-2">
                                        <label>@Html.LabelFor(u => u.Sort, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="editor-field">
                                            @Html.EditorFor(u => u.Sort, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(u => u.Sort, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-1">
                                        <label>@Html.LabelFor(u => u.Title, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-11">
                                        <div class="editor-field">
                                            @Html.EditorFor(u => u.Title, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(u => u.Title, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-2">
                                        <label>@Html.LabelFor(u => u.Description, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-10">
                                        <div class="editor-field">
                                            @Html.TextAreaFor(u => u.Description, new { @class = "form-control", @rows = 2 })
                                            @Html.ValidationMessageFor(u => u.Description, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary px-4"><span>Add &nbsp;<i class="fas fa-plus-circle"></i></span></button>
                                </div>
                            </fieldset>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <br />
</body>
