@model Data.Models.SourceCountryMappingModel
@{
    ViewData["Title"] = "Add Country Mappings";
}

<!DOCTYPE html>
<html>
<body>
    <div class="card">
        <div class="card-header">
            <h3>@ViewData["Title"]</h3>
        </div>
        @using (Html.BeginForm("AddNew", "SourceCountryMapping"))
        {
            @Html.HiddenFor(x => x._id, new { _id = "_id" })
            <div class="form-horizontal">

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div style="width: 50%; margin-top:5%; margin-left:25%; margin-right:25%" class="needs-validation">
                    <fieldset>
                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.Source_Country_ID, htmlAttributes: new { @class = "control-label" })
                            </div>

                            <div class="editor-field">
                                @Html.EditorFor(u => u.Source_Country_ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(u => u.Source_Country_ID, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.Source_Country_Value, htmlAttributes: new { @class = "control-label" })
                            </div>

                            <div class="editor-field">

                                @Html.TextBoxFor(u => u.Source_Country_Value, htmlAttributes: new { @class = "form-control" })
                                @Html.ValidationMessageFor(u => u.Source_Country_Value, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.COUNTRY_NAME, htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class="editor-field">
                                @Html.TextBoxFor(u => u.COUNTRY_NAME, htmlAttributes: new { @class = "form-control" })
                                @Html.ValidationMessageFor(u => u.COUNTRY_NAME, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="editor-label">
                                @Html.LabelFor(u => u.ISSB_Country_Geo_Code, htmlAttributes: new { @class = "control-label" })
                            </div>
                            <div class="editor-field">
                                @Html.TextBoxFor(u => u.ISSB_Country_Geo_Code, htmlAttributes: new { @class = "form-control" })
                                @Html.ValidationMessageFor(u => u.ISSB_Country_Geo_Code, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <hr />
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary px-4"><span>Save &nbsp;<i class="fas fa-file-import"></i></span></button>
                        </div>
                    </fieldset>
                    <br />
                </div>
            </div>
        }
    </div>
</body>
</html>

