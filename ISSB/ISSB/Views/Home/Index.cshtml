<!doctype html>

<!--
ISSB/Views/ReportEngine/SearchResults.cshtml

reporting engine view
-->

@using Infragistics.Web.Mvc
@using Data.Models

@model ReportEngineModel

@{
var search = Model.Search; // search criteria

/*
Set variable separately to indicate which groupable selection is not grouped (itemised separately). Values are as
follows:

    0. none
    1. source countries
    2. market countries
    4. ports
    8. products
16. by month
32. by quarter
64. by year
-1. more than one
*/

var separately = Model.Separately; // selection viewed separately
var allSeparately = Model.AllSeparately; // all selections viewed separately
var member = Model.Search.Values ? "MONETARY_VALUE" : "WEIGHT"; // y-axis member
var oneSep = separately != 0 && separately != -1; // one groupable selection not grouped
var defaultType = separately < 16 ? "column" : "line"; // default data chart type
var tradeFlow = Model.Search.TradeFlow; // trade flow (import, export or both)
}

<html>
<head>
<!--map Chart style-->

<style>


#tooltipTable {
    font-family: Verdana, Arial, Helvetica, sans-serif;
    width: 100%;
    border-collapse: collapse;
}

    #tooltipTable td, #tooltipTable th {
        font-size: 9px;
        border: 1px solid blue;
        padding: 3px 7px 2px 7px;
