                        latitudeMemberPath: "LATITUDE",
                        RadioNodeList: "WEIGHT",
                        radiusMemberPath: "WEIGHT",
                        markerType: "circle",
                        // markerCollisionAvoidance: "fade",
                        markerBrush: "red",
                        markerOutline: "blue",
                        showTooltip: true,
                        tooltipTemplate: "tooltipTemplate",
