        else {
            $("#mapContainer").show();
            worldCities = $.parseJSON($('#DestinationMapData').val());
            startCountry = $.parseJSON($('#SourceMapData').val());
            generateConnections();

            $("#map").igMap({
                width: "100%",
                height: "700px",
                overviewPlusDetailPaneVisibility: "visible",
                overviewPlusDetailPaneBackgroundImageUri: "https://www.igniteui.com/images/samples/maps/world.png",
                windowRect: {
                    left: 0.30,
                    top: 0.20,
                    height: 0.45,
                    width: 0.45
                },
                backgroundContent: {
                    type: "bing",
                    key: "AtD4uTmZrTuLVdF6BFYL7WLDYYJ3S_zf2sWjuXoVFxNW6InFrffIYhrYFqOj-z7_",
                    bingUrl: "https://dev.virtualearth.net/rest/v1/imagery/metadata/",
                    imagerySet: "Road"
                },
                series: [{
                    type: "geographicPolyline",
                    name: "worldConnections",
                    shapeMemberPath: "points",
                    dataSource: worldConnections,
                    shapeFilterResolution: 5.0,
                    outline: "rgba(20,20,20,0.5)",
                    outline: "blue",
                    thickness: 0.75,
                    showTooltip: false,
                },
