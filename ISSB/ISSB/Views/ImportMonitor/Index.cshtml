
@using Infragistics.Web.Mvc
@model IQueryable<Data.Models.ImportErrorLogModel>
<head>
     <style>
        #overlay {
            position: fixed;
            display: none;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.5);
            z-index: 2;
            cursor: pointer;
        }
    </style>
</head>

<body>

    @{
        ViewData["Title"] = "Import Monitor";
    }

    <div class="content-header">
        <h2>@ViewData["Title"]</h2> 
    </div>
     <div id="overlay">
          <div id="text">Updating</div>
    </div>

     <div>
         <button id="postBtn" class="btn btn-warning btn-sm">Post Items to Exceptions</button>
         <button id="excelBtn" class="btn btn-success btn-sm">Export to Excel</button>
         <button id="refreshBtn" class="btn btn-success btn-sm">Load Exception Data</button>
         <button id="deleteBtn" class="btn btn-warning btn-sm">Delete Exceptions</button>
     </div>
    <div><hr /></div>
    <div id="status_message" style=" color: red;font-weight: bold"></div>
    <div id="lock_message" style=" color: blue;font-weight: bold"></div>
    <div id="progressbar" style="position:relative">
        <span id="progressbar-label" style="position:absolute;left:50%; top:20%"></span>
    </div>

    <table id="grid"></table>


<script src="~/lib/signalr/signalr.js"></script>

<script>

     $("#progressbar").progressbar({ value: false }).height(40);
     $("#postBtn").igButton();
     $("#excelBtn").igButton();
     $("#refreshBtn").igButton();
     $("#deleteBtn").igButton();

    $.ajax({
                url: "/ImportMonitor/GetData",
                type: "GET",
                dataType: "json",
                async: true,
                contentType: "application/json",
                success: function (data) {
                    //alert(question);

                    var jData = JSON.stringify(data);
       
                    $("#grid").igGrid({ dataSource: jData });
                    $("#grid").igGrid("dataBind");
                },
                error: function () {
                    alert("No Data");
                }
            });

    $("#postBtn").on("click", function () {
        
        var rowId;
        var rows = $("#grid").igGrid("selectedRows");
        var selectionErrorArray = "";
        if (rows.length > 0) {
            document.getElementById("overlay").style.display = "block";
            $.each(rows, function (ix, el) {
                rowId = el.element.attr("data-id");
                var sCode = $("#grid").igGrid("getCellValue", rowId, "Code");
                var sType = $("#grid").igGrid("getCellValue", rowId, "Type");
                var sID = $("#grid").igGrid("getCellValue", rowId, "_id");
                selectionErrorArray = selectionErrorArray + sType + "," + sCode + "," + sID + "|";
            });

              $.ajax({
                    type: "POST",
                    url: "/ImportMonitor/PostExceptions",
                    async: true,
                    data: {
                        
                        DataArray: selectionErrorArray,
                       
                    },
                    dataType: "json",
                    success: function (data) {
                        document.getElementById("overlay").style.display = "none";
                        $.ajax({
                            url: "/ImportMonitor/GetData",
                            type: "GET",
                            dataType: "json",
                            async: true,
                            contentType: "application/json",
                            success: function (data) {
                                //alert(question);

                                var jData = JSON.stringify(data);
 
                                $("#grid").igGrid({ dataSource: jData });
                   
                                $("#grid").igGrid("dataBind");
                            },
                            error: function () {
                                alert("No Data");
                            }
                        });
                    }

                });
        }
    });

    $("#deleteBtn").on("click", function () {

        var rowId;
        var rows = $("#grid").igGrid("selectedRows");
        var selectionErrorArray = "";
        if (rows.length > 0) {
            document.getElementById("overlay").style.display = "block";
            $.each(rows, function (ix, el) {
                rowId = el.element.attr("data-id");
                var sCode = $("#grid").igGrid("getCellValue", rowId, "Code");
                var sType = $("#grid").igGrid("getCellValue", rowId, "Type");
                var sID = $("#grid").igGrid("getCellValue", rowId, "_id");
                selectionErrorArray = selectionErrorArray + sType + "," + sCode + "," + sID + "|";
            });

            $.ajax({
                type: "POST",
                url: "/ImportMonitor/DeleteExceptions",
                async: true,
                data: {

                    DataArray: selectionErrorArray,

                },
                dataType: "json",
                success: function (data) {
                    document.getElementById("overlay").style.display = "none";
                    $.ajax({
                        url: "/ImportMonitor/GetData",
                        type: "GET",
                        dataType: "json",
                        async: true,
                        contentType: "application/json",
                        success: function (data) {
                            //alert(question);

                            var jData = JSON.stringify(data);

                            $("#grid").igGrid({ dataSource: jData });

                            $("#grid").igGrid("dataBind");
                        },
                        error: function () {
                            alert("No Data");
                        }
                    });
                }

            });
        }
    });


     $("#excelBtn").on("click", function () {
                $.ig.GridExcelExporter.exportGrid($("#grid"), {
                    fileName: "ImportExceptions"
                });
            });

     $("#refreshBtn").on("click", function () {
                $.ajax({
                url: "/ImportMonitor/GetData",
                type: "GET",
                dataType: "json",
                async: true,
                contentType: "application/json",
                success: function (data) {
                    //alert(question);

                    var jData = JSON.stringify(data);
       
                    $("#grid").igGrid({ dataSource: jData });
                    $("#grid").igGrid("dataBind");
                },
                error: function () {
                    alert("No Data");
                }
            });
     
    
    });
           

    var data;
    data = {"_id":"", "Type": "", "Code": "" , "BatchNumber": "", "ErrorMessage": "" };

    
    $("#grid").igGrid({
        autoGenerateColumns: false,
        renderCheckboxes: true,
                columns: [
                    { headerText: "_id", key: "_id", dataType: "string", hidden: true },
                    { headerText: "Type", key: "Type", dataType: "string" , width: "5%" },
                    { headerText: "Code", key: "Code", dataType: "string", width: "10%" },
                    { headerText: "Batch No", key: "BatchNumber", dataType: "string", width: "5%" },
                    { headerText: "Error Message", key: "ErrorMessage", dataType: "string", width: "50%" }
                         
        ],
        dataSource: data,
       
        //renderCheckboxes: false,
        primaryKey: "_id",
                 responseDataKey: "data",
                 dataSourceType: "json",
            features: [
                //{
                //    name: "Paging",
                //    type: "local",
                //    pageSize: 25
                //},
               {
                  name: 'Selection',
                  mode: 'row',
                  multipleSelection: true,
                  activation: true
               },
                {
                    name: 'RowSelectors',
                    enableCheckBoxes: true,
                    enableSelectAllForPaging: true
                },
                {
                    name: "Sorting",
                    type: "local"
                },
                {
                    name: "Filtering",
                    type: "local"
                }

            ]
            });


    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/messageHub")
        .build();

    connection.start().catch(err => console.error(err.toString()));
    
    connection.on("ReceiveMessage", (message) => {

       $('#status_message').html(message);
    
    });

    connection.on("LockMessage", (message) => {

        $('#lock_message').html(message);

    });

    connection.on("ReceiveProgressMessage", (message) => {

        $("#progressbar-label").text(message + "%")
        $("#progressbar").progressbar({
            value: parseInt(message)
           
        }).height(40);
    });
   
</script>

</body>
