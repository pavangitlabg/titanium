@using Infragistics.Web.Mvc
@model Data.Models.ErrorModel
@{

    ViewData["Title"] = "System Error Logs View";

}

<html>
<body>
    <div class="card">
        <div class="card-header">
            <div class="content-header">
                <h2>@ViewData["Title"]</h2>
                <div id="map" class="center"></div>
                <hr />
                @using (Html.BeginForm("Close", "Error"))
                {
                    @Html.HiddenFor(x => x._id, new { _id = "_id" })
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="needs-validation">
                            <fieldset>
                                <br />
                                <div class="form-group row">
                                    <div class="col-sm-1">
                                        <label>@Html.LabelFor(u => u.Code, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-3 editor-field">
                                        @Html.TextBoxFor(u => u.Code, htmlAttributes: new { @class = "form-control" })
                                    </div>
                                    <div class="col-sm-1 offset-sm-1">
                                        <label>@Html.LabelFor(u => u.Class, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-6 editor-field">
                                        @Html.TextBoxFor(u => u.Class, htmlAttributes: new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-1">
                                        <label>@Html.LabelFor(u => u.Date, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-3 editor-field">
                                        @Html.TextBoxFor(u => u.Date, htmlAttributes: new { @class = "form-control" })
                                    </div>
                                    <div class="col-sm-1 offset-sm-1">
                                        <label>@Html.LabelFor(u => u.ErrorMessage, htmlAttributes: new { @class = "control-label" })</label>
                                    </div>
                                    <div class="col-sm-6 editor-field">
                                        @Html.TextAreaFor(u => u.ErrorMessage, htmlAttributes: new { @class = "form-control", @rows = 5 })
                                    </div>
                                </div>
                                <hr />
                                <div class="form-group">
                                    <button onclick="goBack()" class="btn btn-primary px-4"><span>Close &nbsp;<i class="far fa-times-circle"></i></span></button>
                                </div>
                            </fieldset>
                            <br />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <br />
</body>
</html>


