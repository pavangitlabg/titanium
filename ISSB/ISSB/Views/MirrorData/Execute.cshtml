@using Infragistics.Web.Mvc
@model IQueryable<Data.Models.TradeDataModel>
@{
    //ViewData["Title"] = "Trade Data";
}

<head>
    <style>

        .headerStyle {
            text-align: center !important;
        }

        .numberStyle {
            text-align: right !important;
        }

        .optionContainer {
            display: inline-block;
        }

        .item {
            display: inline-block;
            height: 30px;
        }

            .item ~ .item {
                margin-left: 15px;
            }

        .item-label {
            display: block;
            float: right;
            margin-left: 5px;
            line-height: 21px;
        }

        .exporting-overlay {
            position: absolute;
            background-color: rgba(181, 181, 181, 0.9);
            top: 0;
            left: 0;
            z-index: 100000;
            text-align: center;
            vertical-align: top;
            padding-top: 100px;
        }

            .exporting-overlay:after {
                content: "";
                display: inline-block;
                vertical-align: middle;
                height: 100%;
            }

        .exporting-text {
            font-size: 46px;
            font-weight: bold;
            vertical-align: top;
        }
    </style>

</head>
<body>
    <input type="hidden" value="@ViewBag.Year" id="dataYear" />
    <input type="hidden" value="@ViewBag.Month" id="dataMonth" />
    <input type="hidden" value="@ViewBag.GeoCode" id="dataGeoCode" />
    <input type="hidden" value="@ViewBag.TariffCodes" id="dataTariffCodes" />

    <div class="content-header">
        <h3>@ViewData["Title"]</h3>
        <h3>@ViewData["Message"]</h3>
    </div>

    <div>

        @(Html.Infragistics().Grid(Model)
                                    .ID("grid")
                                    .Width("100%")
                                    .Height("600px")
                                    .DataBind()
                                    .PrimaryKey("_id")
                                    .AutoGenerateColumns(false)
                                    .AutoGenerateLayouts(false)
                                    .Columns(column =>
                                    {
                                        column.For(x => x._id).HeaderText("_id").Width("10%").Hidden(true);
                                        column.For(x => x.YEAR).HeaderText("Year").Width("10%");
                                        column.For(x => x.MONTH).HeaderText("Month").Width("10%");
                                        column.For(x => x.QUARTER).HeaderText("Quarter").Width("10%");
                                        column.For(x => x.SC_GEO).HeaderText("SC Geo").Width("10%");
                                        column.For(x => x.MC_GEO).HeaderText("MC Geo").Width("10%");
                                        column.For(x => x.H_TARIFF).HeaderText("H Tariff").Width("10%");
                                        column.For(x => x.SIDE_OF_TRADE).HeaderText("SOT").Width("10%");
                                        column.For(x => x.WEIGHT).HeaderText("Weight").Width("20%").Format("#,##0").HeaderCssClass("numberStyle").ColumnCssClass("numberStyle");
                                        column.For(x => x.MONETARY_VALUE).HeaderText("Value").Width("20%").Format("#,##0").HeaderCssClass("numberStyle").ColumnCssClass("numberStyle");

                                    })
                                    .Features(features =>
                                    {

                                        features.Sorting().Type(OpType.Local).Mode(SortingMode.Multiple)
                                    .ColumnSettings(setting =>
                                    {
                                        setting.ColumnSetting().ColumnKey("_id").AllowSorting(false);

                                    });
                                        features.Sorting().Type(OpType.Local)
                                .ColumnSettings(setting =>
                                {
                                    setting.ColumnSetting().ColumnKey("_id").AllowSorting(false);

                                });
                                        features.Paging().Type(OpType.Local);
                                        features.Filtering().Type(OpType.Local);
                                        features.Selection().MultipleSelection(false);
                                        features.Selection().Mode(SelectionMode.Row);
                                //features.GroupBy().Type(OpType.Local);
                                features.RowSelectors().EnableRowNumbering(true);

                                    })

                                    .Render())
        <hr />
        <div class="form-group row">
            <div class="col-sm-5">

                <button id="upLoadBtn" class="btn btn-outline-primary btn-md">Post for Production &nbsp;<span><i class="fas fa-file-upload"></i></span></button>
                <button id="exportButton" class="btn btn-outline-success btn-md">Export to Excel &nbsp;<span><i class="fas fa-file-export"></i></span></button>
            </div>
        </div>

        <script>$(function () {

                $("#exportButton").on("click", function () {
                    var exportingOverlay = $('<div>');
                    $.ig.GridExcelExporter.exportGrid($("#grid"), {
                        columnsToSkip: ["_id"],
                        fileName: "TradeData",
                        worksheetName: "Data",

                        gridFeatureOptions: { sorting: "applied", filtering: "applied" },
                    },
                        {
                            exportStarting: function (e, args) {
                                showOverlay(args.grid, exportingOverlay);
                            },
                            success: function () {
                                hideOverlay(exportingOverlay);
                            },
                            cellExported: function (e, args) {
                                if (args.xlRow.index() == 0) {
                                    return;
                                }

                            },
                            exportEnding: function (e, args) {
                                //args.worksheet.columns().item(2).cellFormat().formatString("dd-MM-yyyy");
                                //args.worksheet.columns().item(3).cellFormat().formatString("dd-MM-yyyy");
                            },
                        });

                });



                function showOverlay(grid, exportingOverlay) {
                    var $gridContainer = $('#' + grid.attr('id') + '_container');

                    exportingOverlay.css({
                        "width": $gridContainer.outerWidth(),
                        "height": $gridContainer.outerHeight()
                    }).html('<span class="exporting-text">Exporting...</span>');
                    exportingOverlay.addClass("exporting-overlay");

                    $gridContainer.append(exportingOverlay);
                }
                function hideOverlay(exportingOverlay) {
                    exportingOverlay.remove();
                }

            });</script>


        <script>$("#upLoadBtn").on("click", function () {
                var dataYear = $("#dataYear").val();
                var dataMonth = $("#dataMonth").val();
                var dataGeoCode = $("#dataGeoCode").val();
                var dataTariffCodes = $("#dataTariffCodes").val();

    location.href = "/MirrorData/PostExecute?GeoCode=" + dataGeoCode + "&Year=" + dataYear + "&Month=" + dataMonth + "&TariffCodes=" + dataTariffCodes;


            });</script>

    </div>
</body>
