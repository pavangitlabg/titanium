@using Infragistics.Web.Mvc
@model Data.Models.PendingImportModel
@{

    ViewData["Title"] = "Upsert Record";

}

<!DOCTYPE html>
<html>
<head>
</head>

<body>
    <div class="card">
        <div class="card-header">
            <div class="content-header">
                <h2>@ViewData["Title"]</h2>
                <hr />

                @using (Html.BeginForm("SaveHowler", "Upsert"))
                {
                    @Html.HiddenFor(x => x._id, new { _id = "_id" })
                    
                    <div class="form-horizontal">

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div style="width: 50%; margin-top:5%; margin-left:25%; margin-right:25%" class="needs-validation">
                            <fieldset>
                               

                                <div class="form-group">
                                    <div class="editor-label">
                                        @Html.LabelFor(u => u.MONETARY_VALUE, htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="editor-field">

                                        @Html.TextBoxFor(u => u.MONETARY_VALUE, htmlAttributes: new { @class = "form-control", @type="number" })
                                        @Html.ValidationMessageFor(u => u.MONETARY_VALUE, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                 <div class="form-group">
                                    <div class="editor-label">
                                        @Html.LabelFor(u => u.WEIGHT, htmlAttributes: new { @class = "control-label" })
                                    </div>

                                    <div class="editor-field">

                                        @Html.TextBoxFor(u => u.WEIGHT, htmlAttributes: new { @class = "form-control", @type="number"  })
                                        @Html.ValidationMessageFor(u => u.WEIGHT, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <hr />
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary px-4"><span>Save &nbsp;<i class="fas fa-file-import"></i></span></button>
                                </div>
                            </fieldset>
                            <br />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</body>
</html>

