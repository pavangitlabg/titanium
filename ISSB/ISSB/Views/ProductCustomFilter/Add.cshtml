@using Infragistics.Web.Mvc
@model Data.Models.ProductCustomFilterModel
@{
    ViewData["Title"] = "Add Product Filters";
}

<body>
    <div class="card">
        <div class="card-header">
            <h3>@ViewData["Title"]</h3>
        </div>
        <div class="card-body">
            <div class="container py-5">
                <div class="row">
                    <div class="col-md-10 mx-auto">
                        @using (Html.BeginForm("AddNew", "ProductCustomFilter"))
                        {
                            @Html.HiddenFor(x => x._id, new { id = "Id" })
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="needs-validation">
                                <fieldset>
                                  
                                 
                                    <div class="form-group row">
                                       
                                        <div class="col-sm-6">
                                            <label>@Html.LabelFor(u => u.Name, htmlAttributes: new { @class = "control-label" })</label>
                                            <div id="Email" ; class="editor-field">
                                                @Html.TextBoxFor(u => u.Name, htmlAttributes: new { @class = "form-control" })
                                                @Html.ValidationMessageFor(u => u.Name, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                       
                                    </div>

                                    <br />
                                   
                                    <hr />
                                    <div class="form-group">
                                        <div style="color: red; font-weight: bold"> @ViewData["Message"]</div>
                                        <button type="submit" class="btn btn-primary px-4"><span>Add &nbsp;<i class="fas fa-plus-circle"></i></span></button>
                                    </div>
                                </fieldset>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />
</body>