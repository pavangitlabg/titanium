@model Data.Models.LoginModel
@{

    @if (User.Identity.IsAuthenticated)
    {
        ViewData["Title"] = "Logout";
    }
    else
    {
        ViewData["Title"] = "Login";
    }

}


<div class="container-fluid">
    <div class="login-box">
        <div class="login-logo">
            <a href="../Home/Index"><b>ISSB</b></a>
        </div>
        <!-- /.login-logo -->
        <div class="card">
            <div class="card-body login-card-body">
                @if (User.Identity.IsAuthenticated)
                {
                    @using (Html.BeginForm("Logout", "Auth"))
                    {
                        <p class="login-box-msg">Are you sure you want to log out?</p>
                        <div class="card-body login-card-body">
                            <div style="margin:auto; text-align:center">
                                <input type="submit" class="btn btn-danger " form-control" value="Logout" />
                            </div>
                            <br />
                        </div>
                    }
                }
                else
                {
                    @using (Html.BeginForm("Login", "Auth"))
                    {
                        @Html.AntiForgeryToken()
                        <p class="login-box-msg">User Login</p>
                        <div class="form-horizontal">
                           
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="needs-validation">
                                <fieldset>
                                    @Html.ValidationMessageFor(u => u.Email, "", new { @class = "text-danger" })
                                    @Html.TextBoxFor(u => u.Email, htmlAttributes: new { @class = "form-control input-group mb-3", @placeholder = "Email" })

                                    @Html.ValidationMessageFor(u => u.Password, "", new { @class = "text-danger" })
                                    @Html.PasswordFor(u => u.Password, htmlAttributes: new { @class = "form-control input-group mb-3", @placeholder = "Password" })
                                    <div style="color: red; font-weight: bold"> @ViewData["Message"]</div>
                                    <div class="form-group">
                                        <input type="submit" class="btn btn-primary btn-md" value="Login" />
                                    </div>
                                </fieldset>
                                <br />
                            </div>
                        </div>
                    }

                }
            </div>
        </div>
    </div>
</div>