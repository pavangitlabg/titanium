    <script>$("#reportKeys").dblclick(function (evt) {
            var row = $(this);

            var SelectedA = new Array();
            var rows = $("#reportKeys").igGridSelection("selectedRows");
            if (rows.length > 0) {
                $.each(rows, function (ix, el) {
                    rowId = el.element.attr("data-id");
                    var selectedKey = $("#reportKeys").igGrid("getCellValue", rowId, "Key");

                    var selectedSort = $("#sort").val();
                    var res = selectedSort.split(",");
                    for (var i = 0; i < res.length; i++) {

                        SelectedA.push(res[i]);

                    }

                    SelectedA.push(selectedKey);

                    $("#sort").val(SelectedA);

                    document.getElementById("sortBar").innerHTML +=
                        "<a href='#" + selectedKey + "'>" + selectedKey + "</a>"; 

                });
    }

    $('#clearSelected').on('click', function (event) {

        document.getElementById("sortBar").innerHTML = "";
        $('#sort').val("");
    });

        });</script>
    <script>$(function () {

            $("#sort").hide();
            var RecordID = $("#ReportID").val();
            var Selected = new Array();
            Selected.push(RecordID);
            var rows = $("#grid").igGrid("rows");

            for (var i = 0; i < Selected.length; i++) {
                $(rows).each(function (index, el) {
                    if ($(el).attr("data-id") === Selected[i]) {
                        $("#grid").igGridSelection("selectRow", index);
                    }
                });
            }

        });</script>

    <script>function selectRow(rowId) {


