        }

    }

    $('#clearSelected').on('click', function (event) {
        
        document.getElementById("sortBar").innerHTML = "";
        $('#sort').val("");
    });

            $("#htmlEditor").igHtmlEditor({
                width: "98%",
                height: "500px"
            });

            var RecordID = $("#ReportID").val();
            var Selected = new Array();
            Selected.push(RecordID);
            var rows = $("#grid").igGrid("rows");

            for (var i = 0; i < Selected.length; i++) {
                $(rows).each(function (index, el) {
                    if ($(el).attr("data-id") === Selected[i]) {
                        $("#grid").igGridSelection("selectRow", index);
                    }
                });
            }

        });</script>

    <script>function selectRow(rowId) {

            document.getElementById("overlay").style.display = "block";
            $("#ReportID").val(rowId);
            var url = $('#UrlGetFields').val();

            $.ajax({
                type: "POST",
                url: url,
                async: true,
                data: {

                    RecordId: $("#_id").val(),
                    ReportId: rowId

                },
                dataType: "json",
                success: function (data) {
                   
                    if (data.success) {
                        window.location.href = '/Report/Edit?_id=' + $("#_id").val();
                        document.getElementById("overlay").style.display = "none";
                    } else {
                        document.getElementById("overlay").style.display = "none";
                        alert('Update Failed');
                    }
                }

            });



        }</script>
