<body>

    @{
        ViewData["Title"] = "Market Countries";
    }

    <div class="content-header">
        <h2>@ViewData["Title"]</h2>

    </div>

    @(Html.Infragistics().Grid(Model)
                        .ID("grid")
                        .Width("100%")
                        .Height("600px")
                        .DataBind()
                        .PrimaryKey("_id")
                        .AutoGenerateColumns(false)
                        .AutoGenerateLayouts(false)
                        .Columns(column =>
                        {
                            column.For(x => x._id).HeaderText("_id").Width("10%").Hidden(true);
                            column.For(x => x.GEO_CODE).HeaderText("Geo Code").Width("20%");
                            column.For(x => x.NAME).HeaderText("Name").Width("40%");
                            column.For(x => x.REGION_NAME).HeaderText("Region Name").Width("40%");
                            column.For(x => x.REPLACED_GEO_CODE).HeaderText("Replaced Geo Code").Width("10%").Hidden(true);
                            column.For(x => x.START_DATE).HeaderText("Latest Date").Width("10%").Hidden(true);
                            column.For(x => x.LONG_LEGEND).HeaderText("Long Legend").Width("10%").Hidden(true);
                            column.For(x => x.NAME_OLD).HeaderText("Old Name").Width("10%").Hidden(true);
                            column.For(x => x.SHORT_LEGEND).HeaderText("Short Legend").Width("10%").Hidden(true);
                            column.For(x => x.MARKET_COUNTRY_ID).HeaderText("ID").Width("10%").Hidden(true);
                            column.For(x => x.ACTIVE).HeaderText("Active").Width("10%").Hidden(true);
                            column.For(x => x._id).HeaderText("").Width("7%").Template("<input type='button' onclick='editRow(\"${_id}\")' value='Edit' class='btn btn-block bg-gradient-warning btn-sm'/>");
                            column.For(x => x._id).HeaderText("").Width("7%").Template("<input type='button' onclick='deleteRow(\"${_id}\")' value='Delete' class='btn btn-block bg-gradient-danger btn-sm'/>");
                        })
                        .Features(features =>
                        {
                            features.Sorting().Type(OpType.Local).Mode(SortingMode.Multiple)
                            .ColumnSettings(setting =>
                            {
                                setting.ColumnSetting().ColumnKey("_id").AllowSorting(false);

                            });
                            features.Sorting().Type(OpType.Local)
                            .ColumnSettings(setting =>
                            {
                                setting.ColumnSetting().ColumnKey("_id").AllowSorting(false);

                            });
                            features.Paging().Type(OpType.Local);
                            features.Filtering().Type(OpType.Local);

                            features.Selection().MultipleSelection(true);
                            features.Selection().Mode(SelectionMode.Row);
                            //features.GroupBy().Type(OpType.Local);
                            features.RowSelectors().EnableRowNumbering(true);

                        })

                        .Render())

    <hr />
        <div class="form-group row">
            <div class="col-md-5">
                <button id="addBtn" class="btn btn-outline-primary btn-md">Add Item &nbsp;<span><i class="fas fa-folder-plus"></i></span></button>
                <button id="exportButton" class="btn btn-outline-success btn-md">Export to Excel &nbsp;<span><i class="fas fa-file-export"></i></span></button>
                <button id="pdfBtn" class="btn btn-outline-info btn-md">Export to PDF &nbsp;<span><i class="fas fa-file-pdf"></i></span></button>
            </div>                       
        </div>

    <script>$(function () {            
    $("#exportButton").on("click", function () {
            var exportingOverlay = $('<div>');
            $.ig.GridExcelExporter.exportGrid($("#grid"), {
                columnsToSkip: ["_id"],
                fileName: "SourceCountryData",
                worksheetName: "Ports",

                gridFeatureOptions: { sorting: "applied", filtering: "applied" },
            },
                {
                    exportStarting: function (e, args) {
                        showOverlay(args.grid, exportingOverlay);
                    },
                    success: function () {
                        hideOverlay(exportingOverlay);
                    },
                    cellExported: function (e, args) {
                        if (args.xlRow.index() == 0) {
                            return;
                        }

                    },
                    exportEnding: function (e, args) {
                        //args.worksheet.columns().item(2).cellFormat().formatString("dd-MM-yyyy");
                        //args.worksheet.columns().item(3).cellFormat().formatString("dd-MM-yyyy");
                    },
                });

        });

        $("#addBtn").on("click", function () {
            var url = "/MarketCountry/Add";
            $(location).attr('href', url);
        });

        function showOverlay(grid, exportingOverlay) {
            var $gridContainer = $('#' + grid.attr('id') + '_container');

            exportingOverlay.css({
                "width": $gridContainer.outerWidth(),
                "height": $gridContainer.outerHeight()
            }).html('<span class="exporting-text">Exporting...</span>');
            exportingOverlay.addClass("exporting-overlay");

            $gridContainer.append(exportingOverlay);
        }
        function hideOverlay(exportingOverlay) {
            exportingOverlay.remove();
        }

        $("#pdfBtn").on("click", function () {
            window.location.href = 'MarketCountry/PrintPage';
            return false;
        });

    });
            </script>

    <script>

        function editRow(rowId) {

            var url = "/MarketCountry/Edit?_id=" + rowId.toString();
            $(location).attr('href', url);

        }

        function deleteRow(rowId) {
            var grid = $("#grid").data("igGrid");
            grid.dataSource.deleteRow(rowId);

            if (confirm('Do you want to delete?')) {                
            }
            else {
                e.preventDefault()
                grid.commit();            
            }     

            var url = "/MarketCountry/Delete?_id=" + rowId.toString();                                    
            $(location).attr('href', url);
        };
    </script>
</body>
</html>
