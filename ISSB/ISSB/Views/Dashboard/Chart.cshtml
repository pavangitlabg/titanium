//                    height : "350px" ,
//                    dataSource : dataChartData ,
//                    dataSourceType : "json" ,
//                    responseDataKey : "data" ,
//                    legend : { element : "legend" } ,
//                    title : "Energy Production Per Country" ,
//                    subtitle : "Column" ,
//                    axes: [
//                              { name : "xAxis" , type : "categoryX" , label : "Year" , labelTopMargin : 5 } ,
//                              { name : "yAxis" , type : "numericY" , minimumValue : 0 , title : "Quadrillion Btu" }
//                          ],
//                    series : [
//                               CreateSeries( "column" , "MONETARY_VALUE" ) ,
//                             ]
//                }) ;
@* } *@
)
<!--          </div>
          <div id="legend" class="legend" ></div>-->

          break ;

        case 7 :
          // funnel chart

          <div id="chartWeighted" ></div>

          break ;

case 9 :

// line chart

<!--          <div id="columnChart" class="chart" > -->
@(
@* *{
var xAxis = new CategoryXAxis() ; *@

            Html.Infragistics().DataChart( Model.EngineModel.Data ).Width( "320px" ).Height( "350px" )
            //.Axes.Add( new NumericXAxis { Name } )
//.Axes( axes => { axes.CategoryX("xAxis").Label( "Year" ) ; axes.NumericY( "priceAxis" ) ; })
.Axes( axes => { axes.CategoryX("xAxis").Label( "Year" ) ; axes.NumericY( "yAxis" ).MinimumValue( 0 ).Title( "Quadrillion Btu" ) ; })
.Series( series => { series.Line( "valueSeries" ).XAxis( "xAxis" ).YAxis( "yAxis" ).ValueMemberPath( item => item.MONETARY_VALUE ) ; } )
            .DataBind()
            .Render()

