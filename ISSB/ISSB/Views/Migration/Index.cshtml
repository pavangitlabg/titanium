@model Data.Models.MigrationModel
@{
    ViewData["Title"] = "Data Migration Page";
}


<h1>@ViewData["Title"]</h1>


@using (@Html.BeginForm("Start", "Migration"))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">


        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div style="width: 50%; margin-top:5%; margin-left:25%; margin-right:25%" class="needs-validation">
            <fieldset>
                <div class="form-group">

                    <div class="editor-label">
                        @Html.LabelFor(u => u.FilePath, htmlAttributes: new { @class = "control-label " })
                    </div>

                    <div class="editor-field">
                        @Html.TextBoxFor(u => u.FilePath, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(u => u.FilePath, "", new { @class = "text-danger" })
                    </div>
                </div>



                <div class="form-group">
                    <input type="submit" class="btn btn-primary btn-md " form-control" value="Trade Data Migration" />
                </div>
            </fieldset>
            <br />
        </div>
    </div>
}


