<!DOCTYPE html>
@using Infragistics.Web.Mvc
@model IQueryable<Data.Models.DashBoardLayOutModel>
@{
    ViewData["Title"] = "Dashboard Designer";
}
<html>
<head>
    <script src="../js/dashutils.js" type="text/javascript"></script>
    <style>
        .ui-iggrid .ui-iggrid-header, .ui-iggrid table tbody td, .ui-iggrid table th {
            padding: 0 !important;
        }
    </style>
    <style>
        #overlay {
            position: fixed;
            display: none;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.5);
            z-index: 2;
            cursor: pointer;
        }

        #text {
            position: absolute;
            top: 50%;
            left: 50%;
            font-size: 50px;
            color: yellow;
            transform: translate(-50%,-50%);
            -ms-transform: translate(-50%,-50%);
        }
    </style>
</head>

<body oncontextmenu="return false">
    <input type="hidden" value="@Url.Action("DeleteItem", "DashboardCreator")" id="UrlDeleteObject" />
    <input type="hidden" value="@ViewBag.GridList" id="gridList" />
    <input type="hidden" value="@ViewBag.RecordID" id="recordID" />
    <input type="hidden" value="@Url.Action("SaveAll", "DashboardCreator")" id="UrlSaveAll" />
    <input type="hidden" value="@Url.Action("UpdateSaveItem", "DashboardCreator")" id="UrlUpdateObject" />

    <div id="overlay">
        <div id="text">Updating</div>
    </div>

    <div class="content-header">
        <h2>@ViewData["Title"]</h2>
        <h3>@ViewData["Message"]</h3>
        <br />

        <div class="container-fluider">
            <form>
                <div class="form-group row">
                    <label for="DashName" class="col-sm-2 col-form-label">Dashboard Name:</label>
                    <div class="col-sm-8">
                        <input id="dashname" type="text" class="form-control" name="DashName" value="@ViewData["DashName"]" placeholder="Dashboard Name" required>
                        <div id="error_message" style="color: red; font-weight: bold"></div>
                    </div>
                </div>

                <div class="form-group row">
                    <label for="Description" class="col-sm-2 col-form-label">Description:</label>
                    <div class="col-sm-8">
                        <textarea id="description" class="form-control" name="Description" type="text" >@ViewBag.DashDescription</textarea>
                        <div id="error_message" style="color: red; font-weight: bold"></div>
                    </div>
                </div>
            </form>
            <div class="form-group row">
                <div class="col-sm-2"></div>
                <div class="col-sm-8">
                    <div id="error_message_post" style="color: red; font-weight: bold"></div>
                    <button id="saveAll" class="btn btn-outline-primary btn-sm" onclick="dashutils.SaveAll()">Save To Dashboards</button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-10">

                <div class="card bg-dark">
                    <div id="dropzone" class="card-header" ondrop="dashutils.drop(event)" ondragover="dashutils.allowDrop(event)" ondragleave="dashutils.removeStyle(event)">
                        Drop Zone
                    </div>

                    @Html.Raw(@ViewBag.HTML)


                </div>

            </div>

            <!--Chart Layout Drag Items-->
            <div class="col-md-2">
                <div class="card">
                    <div class="card-header droptarget bg-dark">
                        <h3 class="card-title">Charts Layout</h3>
                    </div>
                    <div class="card-body" style="display: block; text-align:center; padding:0 !important">

                        @(Html.Infragistics().Grid(Model)
                                                           .ID("imagegrid")
                                                           .Width("100%")
                                                           .DataBind()
                                                           .ShowHeader(false)
                                                           .PrimaryKey("ID")
                                                           .AutoGenerateColumns(false)
                                                           .AutoGenerateLayouts(false)
                                                           .Columns(column =>
                                                           {
                                                               column.For(x => x.ID).HeaderText("ID").Width("10%").Hidden(true);
                                                               column.For(x => x.ImageUrl).HeaderText("IMG").Width("100%").Template("<img style=\"height:auto; width:100%; padding:3px\" src=\"${ImageUrl}\"/>");

                                                                           })
                                                                           .Features(features =>
                                                                           {
                                                                               features.Selection().MultipleSelection(true);
                                                                               features.Selection().Mode(SelectionMode.Row);

                                                                           })

                                                                         .Render())
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

</body>
</html>