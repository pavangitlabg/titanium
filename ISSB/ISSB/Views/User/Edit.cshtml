@using Infragistics.Web.Mvc
@model Data.Models.UserModel
@{

    ViewData["Title"] = "Edit System User";

}

<head>
    <script src="../js/User.js" type="text/javascript"></script>

    <style>

        #overlay {
            position: fixed;
            display: none;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.5);
            z-index: 2;
            cursor: pointer;
        }

        #text {
            position: absolute;
            top: 50%;
            left: 50%;
            font-size: 50px;
            color: yellow;
            transform: translate(-50%,-50%);
            -ms-transform: translate(-50%,-50%);
        }
    </style>

    <style>

        #overlay {
            position: fixed;
            display: none;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.5);
            z-index: 2;
            cursor: pointer;
        }
    </style>

</head>
<body>
    <div id="overlay">
        <div id="text">Updating...</div>
    </div>
    @using (Html.BeginForm("Save", "User"))
    {
        @Html.HiddenFor(x => x._id, new { id = "Id" })
        @Html.HiddenFor(x => x.NavBar, new { id = "NavBar" })
        @Html.HiddenFor(x => x.BrandLink, new { id = "BrandLink" })
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <input type="hidden" value="@Url.Action("UpdateSourceCountries", "User")" id="UrlUpdate" />
        <input type="hidden" value="@Url.Action("RemoveSourceCountries", "User")" id="UrlRemove" />
        <input type="hidden" value="@Url.Action("UpdateTariffCodes", "User")" id="UrlUpdateTariff" />
        <input type="hidden" value="@Url.Action("RemoveTariffCodes", "User")" id="UrlRemoveTariff" />
        <input type="hidden" value="@Url.Action("AllSteelCodes", "User")" id="UrlAllSteel" />
        <input type="hidden" value="@ViewBag.TCList" id="TCListID" />
        <input type="hidden" value="@ViewBag.CostomFilters" id="CustomFiltersID" />
        <input type="hidden" value="@ViewBag.UserCostomFilters" id="UserCustomFiltersID" />
        <input type="hidden" value="@Url.Action("UpdateCustoFilters", "User")" id="UrlUpdateFilters" />
        <input type="hidden" value="@Url.Action("RemoveCustomFilters", "User")" id="UrlRemoveFilters" />

        <fieldset>
            <div class="card">
                <div class="card-header">
                    <h2>@ViewData["Title"]</h2>
                </div>

                <div class="needs-validation">
                    <div class="card-body">

                        <!--TABS-->
                        <ul class="nav nav-tabs" id="crm-tab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="details-tab" data-toggle="pill" href="#userProfile">User Profile</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="default-tab" data-toggle="pill" href="#sourceCountries">Allowed Source Countries</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="credit-control-tab" data-toggle="pill" href="#ttariff">Allowed Tariff Codes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="credit-control-tab" data-toggle="pill" href="#customfilter">Custom Tariff Filters</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="credit-control-tab" data-toggle="pill" href="#years">Allowed Years</a>
                            </li>

                        </ul>

                        <!--tab CONTENT-->

                        <div class="tab-content" id="crm-tabContent">

                            <!--userProfile tab-->
                            <div class="tab-pane fade active show" id="userProfile">

                                <div class="container py-5">
                                    <div class="row">
                                        <div class="col-md-10 mx-auto">
                                            <h5>Account Details</h5>
                                            <hr />
                                            <div class="form-group row">
                                                <div class="col-sm-2">
                                                    <label>
                                                        @Html.LabelFor(u => u.IsAdministrator, htmlAttributes: new { @class = "control-label" }) &nbsp;
                                                        @Html.CheckBoxFor(u => u.IsAdministrator, "true")
                                                    </label>
                                                </div>
                                                <div class="col-sm-2">
                                                    <label>
                                                        @Html.LabelFor(u => u.IsSystemUser, htmlAttributes: new { @class = "control-label" }) &nbsp;
                                                        @Html.CheckBoxFor(u => u.IsSystemUser, "true")
                                                    </label>
                                                </div>
                                                <div class="col-sm-2">
                                                    <label>
                                                        @Html.LabelFor(u => u.IsAdvancedUser, htmlAttributes: new { @class = "control-label" }) &nbsp;
                                                        @Html.CheckBoxFor(u => u.IsAdvancedUser, "true")
                                                    </label>
                                                </div>
                                                <div class="col-sm-2">
                                                    <label>
                                                        @Html.LabelFor(u => u.IsTradeInquiry, htmlAttributes: new { @class = "control-label" }) &nbsp;
                                                        @Html.CheckBoxFor(u => u.IsTradeInquiry, "true")
                                                    </label>
                                                </div>
                                                <div class="col-sm-4">
                                                    <label>
                                                        @Html.LabelFor(u => u.TwoFactorAuth, htmlAttributes: new { @class = "control-label" }) &nbsp;
                                                        @Html.CheckBoxFor(u => u.TwoFactorAuth, "true")
                                                    </label>
                                                </div>
                                                <div class="col-sm-4">
                                                    <label>
                                                        @Html.LabelFor(u => u.EmailNotification, htmlAttributes: new { @class = "control-label" }) &nbsp;
                                                        @Html.CheckBoxFor(u => u.EmailNotification, "true")
                                                    </label>
                                                </div>
                                                <div class="col-sm-4">
                                                    <label>
                                                        @Html.LabelFor(u => u.IsAPI, htmlAttributes: new { @class = "control-label" }) &nbsp;
                                                        @Html.CheckBoxFor(u => u.IsAPI, "true")
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-sm-4">
                                                    <label>@Html.LabelFor(u => u.AccountStatus, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="AccountStatus" ; class="editor-field">
                                                        @Html.DropDownListFor(u => u.AccountStatus, new List<SelectListItem> {
                                            new SelectListItem{Text="Open", Value="Open"},
                                            new SelectListItem{Text="Closed", Value="Closed"}}, new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(u => u.AccountStatus, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-4">
                                                    <label>@Html.LabelFor(u => u.StartDate, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="StartDate" ; class="editor-field">
                                                        @Html.EditorFor(u => u.StartDate, new { htmlAttributes = new { @class = "form-control datepicker" } })
                                                        @Html.ValidationMessageFor(u => u.StartDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-4">
                                                    <label>@Html.LabelFor(u => u.ExpiryDate, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="ExpiryDate" ; class="editor-field">
                                                        @Html.EditorFor(u => u.ExpiryDate, new { htmlAttributes = new { @class = "form-control datepicker" } })
                                                        @Html.ValidationMessageFor(u => u.ExpiryDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-sm-4">
                                                    <label>@Html.LabelFor(u => u.UserName, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="UserName" ; class="editor-field">
                                                        @Html.TextBoxFor(u => u.UserName, "", new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(u => u.UserName, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-4">
                                                    <label>@Html.LabelFor(u => u.Email, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="Email" ; class="editor-field">
                                                        @Html.TextBoxFor(u => u.Email, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                                        @Html.ValidationMessageFor(u => u.Email, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-4">
                                                    <label>@Html.LabelFor(u => u.Password, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="Password" ; class="editor-field">
                                                        @Html.TextBoxFor(u => u.Password, htmlAttributes: new { @class = "form-control", @type = "password" })
                                                        @Html.ValidationMessageFor(u => u.Password, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <br />
                                            <hr />
                                            <h5>Personal Identifcation Details</h5>
                                            <hr />
                                            <div class="form-group row">
                                                <div class="col-sm-6">
                                                    <label>@Html.LabelFor(u => u.FirstName, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="FirstName" ; class="editor-field">
                                                        @Html.TextBoxFor(u => u.FirstName, new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(u => u.FirstName, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label>@Html.LabelFor(u => u.LastName, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="LastName" ; class="editor-field">
                                                        @Html.TextBoxFor(u => u.LastName, new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(u => u.LastName, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group row">
                                                <div class="col-sm-6">
                                                    <label>@Html.LabelFor(u => u.CompanyName, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="CompanyName" ; class="editor-field">
                                                        @Html.TextBoxFor(u => u.CompanyName, new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(u => u.CompanyName, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label>@Html.LabelFor(u => u.Address1, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="Address1" ; class="editor-field">
                                                        @Html.TextAreaFor(u => u.Address1, new { @class = "form-control", id = "upperBox", @rows = 1 })
                                                        @Html.ValidationMessageFor(u => u.Address1, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-sm-6">
                                                    <label>@Html.LabelFor(u => u.PostalCode, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="PostalCode" ; class="editor-field">
                                                        @Html.TextBoxFor(u => u.PostalCode, htmlAttributes: new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(u => u.PostalCode, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label>@Html.LabelFor(u => u.Address2, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="Address2" ; class="editor-field">
                                                        @Html.TextAreaFor(u => u.Address2, new { @class = "form-control", @rows = 1 })
                                                        @Html.ValidationMessageFor(u => u.Address2, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-sm-3">
                                                    <label>@Html.LabelFor(u => u.Telephone, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="Comment" ; class="editor-field">
                                                        @Html.TextBoxFor(u => u.Telephone, htmlAttributes: new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(u => u.Telephone, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-3">
                                                    <label>@Html.LabelFor(u => u.Mobile, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="Mobile" ; class="editor-field">
                                                        @Html.TextBoxFor(u => u.Mobile, htmlAttributes: new { @class = "form-control" })
                                                        @Html.ValidationMessageFor(u => u.Mobile, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label>@Html.LabelFor(u => u.Address3, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="Address3" ; class="editor-field">
                                                        @Html.TextAreaFor(u => u.Address3, new { @class = "form-control", @rows = 1 })
                                                        @Html.ValidationMessageFor(u => u.Address3, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group row">
                                                <div class="col-sm-6">
                                                    <label>@Html.LabelFor(u => u.Costs, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="Costs" ; class="editor-field">
                                                        @Html.TextBoxFor(u => u.Costs, new { type = "number", min = "0", step = "0.01", @class = "form-control" })
                                                        @Html.ValidationMessageFor(u => u.Costs, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label>@Html.LabelFor(u => u.Address4, htmlAttributes: new { @class = "control-label" })</label>
                                                    <div id="Address4" ; class="editor-field">
                                                        @Html.TextAreaFor(u => u.Address4, new { @class = "form-control", @rows = 1 })
                                                        @Html.ValidationMessageFor(u => u.Address4, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!--sourceCountries-->
                            <div class="tab-pane fade" id="sourceCountries">
                                <div class="container py-5">
                                    <div class="row">
                                        <div>
                                            <div class="form-group row">
                                                <div class="col-sm-5 card card-outline card-success">
                                                    <div id="error_message" style="color: red; font-weight: bold"></div>
                                                    @(Html.Infragistics().Grid(Model.SCList.AsQueryable())
                                                                                                    .ID("SourceCountries")
                                                                                                    .Width("100%")
                                                                                                    .Height("300px")
                                                                                                    .DataBind()
                                                                                                    .PrimaryKey("GEO_CODE")
                                                                                                            .AutoGenerateColumns(false)
                                                                                                            .AutoGenerateLayouts(false)
                                                                                                            .Columns(column =>
                                                                                                        {
                                                                                                            column.For(x => x.GEO_CODE).HeaderText("Code").Width("20%");
                                                                                                            column.For(x => x.NAME).HeaderText("Name").Width("80%");
                                                                                                            column.For(x => x.LATEST_DATE).HeaderText("Last Upaded").Format("dd-MM-yyyy").Width("25%").Hidden(true);
                                                                                                        })
                                                                                                    .Features(features =>
                                                                                                    {
                                                                                                        features.Sorting().Type(OpType.Local);
                                                                                                        features.Filtering().Type(OpType.Local);
                                                                                                        features.RowSelectors().EnableCheckBoxes(true);
                                                                                                        features.Selection().MultipleSelection(true);
                                                                                                                                        //features.Selection().Mode(SelectionMode.Row);


                                                                                                                                    })
                                                                                                        .Render())
                                                </div>
                                                <div class="col-sm-2">
                                                    <div class="form-group row">
                                                        <div class="btn-group-vertical col-md-10 offset-sm-1" style="margin-top: 50%">
                                                            <button id="addSCBtn" type="button" class="btn btn-outline-success">Add &nbsp<span><i class="fas fa-angle-double-right"></i></span></button>
                                                            <button id="removeSCBtn" type="button" class="btn btn-outline-danger"><span><i class="fas fa-angle-double-left"></i>&nbsp Remove</span></button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-sm-5 card card-outline card-danger">
                                                    <div id="error_message1" style="color: red; font-weight: bold"></div>
                                                    @(Html.Infragistics().Grid(Model.AllowedSourceCountries.AsQueryable())
                                                                                        .ID("SourceCountriesAllowed")
                                                                                        .Width("100%")
                                                                                        .Height("300px")
                                                                                        .DataBind()
                                                                                        .PrimaryKey("GEO_CODE")
                                                                                                    .AutoGenerateColumns(false)
                                                                                                    .AutoGenerateLayouts(false)
                                                                                                    .Columns(column =>
                                                                                            {
                                                                                                column.For(x => x.GEO_CODE).HeaderText("Code").Width("20%");
                                                                                                column.For(x => x.NAME).HeaderText("Name").Width("80%");
                                                                                                column.For(x => x.LATEST_DATE).HeaderText("Last Upaded").Format("dd-MM-yyyy").Width("25%").Hidden(true);
                                                                                            })
                                                                                        .Features(features =>
                                                                                        {
                                                                                            features.Sorting().Type(OpType.Local);
                                                                                            features.Filtering().Type(OpType.Local);
                                                                                            features.RowSelectors().EnableCheckBoxes(true);
                                                                                            features.Selection().MultipleSelection(true);

                                                                                        })
                                                                                            .Render())
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!--tariff CONTROLS-->
                            <div class="tab-pane fade" id="ttariff">
                                <div class="container py-5">
                                    <div class="row">
                                        <div>
                                            <div class="form-group row">

                                                <div class="col-sm-5 card card-outline card-success">
                                                    <button id="allSteel" type="button" class="btn btn-outline-success">Select All Steel &nbsp<span><i class="fas fa-angle-double-right"></i></span></button>

                                                    <div id="error_message2" style="color: red; font-weight: bold"></div>
                                                    @(Html.Infragistics().Grid(Model.TCList.AsQueryable())
                                                                                .ID("TariffCodes")
                                                                                .Width("100%")
                                                                                .Height("300px")
                                                                                .DataBind()
                                                                                .PrimaryKey("TariffCode")
                                                                                        .AutoGenerateColumns(false)
                                                                                        .AutoGenerateLayouts(false)
                                                                                        .Columns(column =>
                                                                                    {
                                                                                        column.For(x => x.TariffCode).HeaderText("Code").Width("30%");
                                                                                        column.For(x => x.Name).HeaderText("Name").Width("70%");

                                                                                    })
                                                                                .Features(features =>
                                                                                {
                                                                                    features.Sorting().Type(OpType.Local);
                                                                                    features.Filtering().Type(OpType.Local);
                                                                                    features.RowSelectors().EnableCheckBoxes(true);
                                                                                    features.Selection().MultipleSelection(true);
                                                                                                                    //features.Selection().Mode(SelectionMode.Row);


                                                                                                                })
                                                                                    .Render())
                                                </div>
                                                <div class="col-sm-2">
                                                    <div class="form-group row">
                                                        <div class="btn-group-vertical col-md-10 offset-sm-1" style="margin-top: 50%">
                                                            <button id="addTCBtn" type="button" class="btn btn-outline-success">Add &nbsp<span><i class="fas fa-angle-double-right"></i></span></button>
                                                            <button id="removeTCBtn" type="button" class="btn btn-outline-danger"><span><i class="fas fa-angle-double-left"></i>&nbsp Remove</span></button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-sm-5 card card-outline card-danger">
                                                    <div id="error_message3" style="color: red; font-weight: bold"></div>

                                                    <table id="TariffCodesA"></table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--custom Filters-->
                            <div class="tab-pane fade" id="customfilter">
                                <div class="container py-5">
                                    <div class="row">
                                        <div>
                                            <div class="form-group row">

                                                <div class="col-sm-5 card card-outline card-success">

                                                    <div id="error_message4" style="color: red; font-weight: bold"></div>
                                                    <table id="CustomFiltersGrid"></table>
                                                </div>
                                                <div class="col-sm-2">
                                                    <div class="form-group row">
                                                        <div class="btn-group-vertical col-md-10 offset-sm-1" style="margin-top: 50%">
                                                            <button id="addCFBtn" type="button" class="btn btn-outline-success">Add &nbsp<span><i class="fas fa-angle-double-right"></i></span></button>
                                                            <button id="removeCFBtn" type="button" class="btn btn-outline-danger"><span><i class="fas fa-angle-double-left"></i>&nbsp Remove</span></button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-sm-5 card card-outline card-danger">
                                                    <div id="error_message5" style="color: red; font-weight: bold"></div>

                                                    <table id="CustomFiltersA"></table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--Year CONTROLS-->
                            <div class="tab-pane fade" id="years">
                                <div class="container py-5">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-group row">
                                                <div class="col-md-2">
                                                    <label>@Html.LabelFor(u => u.AllowedYears, htmlAttributes: new { @class = "control-label" })</label>
                                                </div>
                                                <div id="YearsAllowed" ; class="col-md-10 editor-field">
                                                    @Html.TextBoxFor(u => u.AllowedYears, htmlAttributes: new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(u => u.AllowedYears, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary px-4"><span>Save &nbsp;<i class="fas fa-file-import"></i></span></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
    }
    <br />
</body>


