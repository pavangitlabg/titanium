@using Infragistics.Web.Mvc
@model Data.Models.UserPasswordModel

@{

    ViewData["Title"] = "Change Password";

}

<body>
    <br />
    <div class="card">
        <div class="card-header">
            <h3>@ViewData["Title"]</h3>
        </div>

        <div class="container py-5">
            <div class="row">
                <div class="col-md-10 mx-auto">
                    @using (Html.BeginForm("UpdatePassword", "User"))
                    {
                        @Html.HiddenFor(x => x._id, new { id = "Id" })
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="needs-validation">
                            <fieldset>
                                <br />
                              
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label>@Html.LabelFor(u => u.OldPassword, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="UserName" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.OldPassword, new { @class = "form-control" ,  @type = "password"})
                                            @Html.ValidationMessageFor(u => u.OldPassword, "", new { @class = "text-danger" })
                                              <div style="color: red; font-weight: bold"> @ViewData["Message"]</div>
                                        </div>
                                    </div>
                                   
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label>@Html.LabelFor(u => u.NewPassword, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="UserName" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.NewPassword, new { @class = "form-control", @type = "password" })
                                            @Html.ValidationMessageFor(u => u.NewPassword, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                   
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label>@Html.LabelFor(u => u.VerifyPassword, htmlAttributes: new { @class = "control-label" })</label>
                                        <div id="UserName" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.VerifyPassword, new { @class = "form-control" ,  @type = "password"})
                                            @Html.ValidationMessageFor(u => u.VerifyPassword, "", new { @class = "text-danger" })
                                            <div style="color: red; font-weight: bold"> @ViewData["Message1"]</div>
                                        </div>
                                    </div>
                                   
                                </div>

                               
                                <hr />
                                <div class="form-group">
                                    <input type="submit" class="btn btn-warning px-4" form-control" value="Update" />
                                </div>
                            </fieldset>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <br />
</body>