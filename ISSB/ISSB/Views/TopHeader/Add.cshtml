@model Data.Models.TopHeaderModel
@{

    ViewData["Title"] = "Add Content";

}

<body>
    <br />
    <div class="card sourceC">
        <div class="card-header">
            <h3>@ViewData["Title"]</h3>
        </div>

        <div class="container py-5">
            <div class="row">
                <div class="col-md-10 mx-auto">
                    @using (Html.BeginForm("AddNew", "TopHeader"))
                    {
                     
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="needs-validation">
                        <fieldset>
                            <div class="form-group">
                                <div class="editor-label">
                                    @Html.LabelFor(u => u.Title, htmlAttributes: new { @class = "control-label" })
                                </div>

                                <div class="editor-field">
                                    @Html.TextBoxFor(u => u.Title, htmlAttributes: new { @class = "form-control" })
                                    @Html.ValidationMessageFor(u => u.Title, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="editor-label">
                                    @Html.LabelFor(u => u.Description, htmlAttributes: new { @class = "control-label" })
                                </div>

                                <div class="editor-field">

                                    @Html.TextBoxFor(u => u.Description, htmlAttributes: new { @class = "form-control" })
                                    @Html.ValidationMessageFor(u => u.Description, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="form-group">
                                <div class="editor-label">
                                    @Html.LabelFor(u => u.IsActive, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="editor-field">
                                    @Html.CheckBoxFor(u => u.IsActive, htmlAttributes: new { @class = "form-control" })
                                    @Html.ValidationMessageFor(u => u.IsActive, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="editor-label">
                                    @Html.LabelFor(u => u.IsFooter, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="editor-field">
                                    @Html.CheckBoxFor(u => u.IsFooter, htmlAttributes: new { @class = "form-control" })
                                    @Html.ValidationMessageFor(u => u.IsFooter, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="editor-label">
                                    @Html.LabelFor(u => u.HTML, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="editor-field">
                                    @Html.TextAreaFor(u => u.HTML, new { @class = "form-control", @rows = 10 })

                                    @Html.ValidationMessageFor(u => u.HTML, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <hr />
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary px-4"><span>Add &nbsp;<i class="fas fa-plus-circle"></i></span></button>
                            </div>
                        </fieldset>
                        <br />
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <br />
</body>