@model Data.Models.SourceCountryModel

@{

    ViewData["Title"] = "Edit Source Country";

}

<body>    
        <div class="card sourceC">
            <div class="card-header">
                <h3>@ViewData["Title"]</h3>
            </div>

            <div class="container py-5">
                <div class="row">
                    <div class="col-md-10 mx-auto">
                        @using (Html.BeginForm("Save", "SourceCountry"))
                        {
                            @Html.HiddenFor(x => x._id, new { _id = "_id" })
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <fieldset>
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label for="ACTIVE">Active</label>
                                        @* <div id="ACTIVE" ; class="editor-field">
                                                @Html.TextBoxFor(u => u.ACTIVE, htmlAttributes: new { @class = "form-control" })
                                                @Html.ValidationMessageFor(u => u.ACTIVE, "", new { @class = "text-danger" })
                                            </div> *@
                                        <div id="ACTIVE" ; class="editor-field">
                                            @Html.DropDownListFor(u => u.ACTIVE, new List<SelectListItem> {
                                        new SelectListItem{Text="Yes", Value="Y"},
                                        new SelectListItem{Text="No", Value="N"}}, "Please Select", new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.ACTIVE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <label for="SOURCE_COUNTRY_ID">Source Country ID</label>
                                        <div id="SOURCE_COUNTRY_ID" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.SOURCE_COUNTRY_ID, "", new { @class = "form-control", id = "upperBox", onkeyup = "upperCase()", @readonly = "readonly" })
                                            @Html.ValidationMessageFor(u => u.SOURCE_COUNTRY_ID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <label for="GEO_CODE">GEO Code</label>
                                        <div id="GEO_CODE" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.GEO_CODE, new { @class = "form-control", id = "upperBox", onkeyup = "upperCase()", @readonly = "readonly" })
                                            @Html.ValidationMessageFor(u => u.GEO_CODE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label for="NAME">Name</label>
                                        <div id="NAME" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.NAME, new { @class = "form-control", id = "upperBox", onkeyup = "upperCase()" })
                                            @Html.ValidationMessageFor(u => u.NAME, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <label for="REGION_NAME">Region Name</label>
                                        <div id="REGION_NAME" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.REGION_NAME, htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.REGION_NAME, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label for="SHORT_LEGEND">Short Legend</label>
                                        <div id="SHORT_LEGEND" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.SHORT_LEGEND, htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.SHORT_LEGEND, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <label for="LONG_LEGEND">Long Legend</label>
                                        <div id="LONG_LEGEND" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.LONG_LEGEND, htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.LONG_LEGEND, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label for="FREQUENCY">Frequency</label>
                                        <div id="FREQUENCY" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.FREQUENCY, htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.FREQUENCY, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <label for="LATEST_DATE">Latest Date</label>
                                        <div id="LATEST_DATE" ; class="editor-field">
                                            @Html.EditorFor(u => u.LATEST_DATE, new { htmlAttributes = new { @class = "form-control datepicker" } })
                                            @Html.ValidationMessageFor(u => u.LATEST_DATE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <label for="FIRST_DATE">First Date</label>
                                        <div id="FIRST_DATE" ; class="editor-field">
                                            @Html.EditorFor(u => u.FIRST_DATE, new { htmlAttributes = new { @class = "form-control datepicker" } })
                                            @Html.ValidationMessageFor(u => u.FIRST_DATE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label for="SIDE_OF_TRADE">Side of Trade</label>
                                        <div id="SIDE_OF_TRADE" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.SIDE_OF_TRADE, htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.SIDE_OF_TRADE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <label for="GEO_CODE_DISCONTINUED_DATE">Geo Code Discontinued Date</label>
                                        <div id="GEO_CODE_DISCONTINUED_DATE" ; class="editor-field">
                                            @Html.EditorFor(u => u.GEO_CODE_DISCONTINUED_DATE, new { htmlAttributes = new { @class = "form-control datepicker" } })
                                            @Html.ValidationMessageFor(u => u.GEO_CODE_DISCONTINUED_DATE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <label for="DATA_FORMAT">Data Format</label>
                                        <div id="DATA_FORMAT" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.DATA_FORMAT, htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.DATA_FORMAT, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        <label for="CURRENCY_CODE">Currency Code</label>
                                        <div id="CURRENCY_CODE" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.CURRENCY_CODE, htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.CURRENCY_CODE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <label for="INDUSTRY_REPORTING_CENTRE_ID">Industry Reporting Centre ID</label>
                                        <div id="INDUSTRY_REPORTING_CENTRE_ID" ; class="editor-field">
                                            @Html.TextBoxFor(u => u.INDUSTRY_REPORTING_CENTRE_ID, htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(u => u.INDUSTRY_REPORTING_CENTRE_ID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <hr />
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary px-4"><span>Save &nbsp;<i class="fas fa-file-import"></i></span></button>
                                </div>
                            </fieldset>
                        }
                    </div>

                </div>
            </div>
        </div>    
    <br />
</body>