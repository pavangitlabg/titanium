    PortsModel Country { get; set; } = new();
    private List<object> _toolBar = new() { "ExcelExport", "Search" };
    private bool IsLoading { get; set; } = true;
    private RenderFragment _dynamicRenderFragment;

    private PortsModel SelectedRow { get; set; } = new();
