        // await Grid.SelectRowAsync(RowIndex, true);
        // var userSelected = Grid.SelectedRecords;
        // ModelService.CurrentUserModel = SelectedRow;
        // var gModel = new GridIndexModel { PageIndex = PageIndex, RowIndex = RowIndex };
        // ModelService.CurrentGridModel = gModel;
        // // Set the Blazor component to load dynamically
        // SelectedComponent = typeof(SalesProfileModel);
        //
        // // Pass parameters to the component
        // ComponentParameters = new Dictionary<string, object>
        // {
        //     { "userModel", SelectedRow }
        // };
        //
        // _isEdit = true;
    }

    public async Task DataToolbarClickHandler(ClickEventArgs args)
    {
        if (args.Item.Text == "Excel Export")
        {
            await Grid.ExportToExcelAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsLoading = true;
            SelectedRow.Name = string.Empty;
            _ports = await PortsService.GetAllPorts();
            IsLoading = false;
            _isEdit = false;
            await InvokeAsync(() => { StateHasChanged(); });
        }
    }

}
