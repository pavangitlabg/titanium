    public async Task DataToolbarClickHandler(ClickEventArgs args)
    {
        if (args.Item.Text == "Excel Export")
        {
            await Grid.ExportToExcelAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsLoading = true;
            SelectedRow.CONTACT_NAME = string.Empty;
            var usrService = new SalesProfileService();
            _users = await usrService.GetSalesProfiles();
            IsLoading = false;
            _isEdit = false;
