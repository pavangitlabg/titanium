    public void PageChangedHandler(GridPageChangedEventArgs args)
    {
        PageIndex = args.CurrentPage;
    }

    private void OnRowSelected(RowSelectEventArgs<SalesProfileModel> args)
    {
        SelectedRow = args.Data;
        RowIndex = args.RowIndex; // Global index
        SelectedRowIndexOnPage = args.RowIndex % _pageSize + 1; // Index within current page
    }

