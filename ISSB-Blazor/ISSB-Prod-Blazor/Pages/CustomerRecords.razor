@page "/CustomerRecords"
<style>

    .selected-name-customrec{
        font-family: 'Assistant-SemiBold', sans-serif;
        color: #34568B;!important;
        font-size: 15px;
        font-weight: bolder;
        letter-spacing: 3px;
        text-transform: uppercase;
        /*font-style:italic;*/
        /*margin-top:20px;*/
        margin-left:10px;
        text-decoration: underline;
        text-decoration-style: solid;
        text-decoration-thickness: 3px;
        text-underline-offset: 8px
    }


    .page-title-customrec{
        font-family: 'Assistant-SemiBold', sans-serif;
        /*color: #a89f9f!important;*/
        color: #34568B;!important;
        font-size: 15px;
        font-weight: bolder;
        letter-spacing: 3px;
        text-transform: uppercase;
        /*font-style:italic;*/
        margin-top:20px;
        margin-left:10px;
    }

    .btn-79,
    .btn-79 *,
    .btn-79 :after,
    .btn-79 :before,
    .btn-79:after,
    .btn-79:before {
        border: 0 solid;
        box-sizing: border-box;
    }
    .btn-79.e-btn:focus,
    .btn-79.e-btn:active {
        border: none !important;
        box-shadow: none !important;
    }


    .btn-79 .e-btn :hover{
        /*color: #385273 !important;*/
        color: #a89f9f!important;
    }

    .btn-79 {
        -webkit-tap-highlight-color: transparent;
        -webkit-appearance: button;
        background-color: #FFFFFF !important;
        background-image: none;
        /*color: #079CAC!important;*/
        color: #a89f9f!important;
        cursor: pointer;
        font-family: 'Assistant-Regular', sans-serif;
        font-size: 100%;
        font-weight: 900;
        line-height: 1.5;
        margin: 0;
        -webkit-mask-image: -webkit-linear-gradient(#6f8fb8, #0dcaf0);
        padding: 0;
    }
    .btn-79:disabled {
        cursor: default;
    }
    .btn-79:-moz-focusring {
        outline: auto;
    }
    .btn-79 svg {
        display: block;
        vertical-align: middle;
    }
    .btn-79 [hidden] {
        display: none;
    }
    .btn-79 {
        --height: 60px;
        background: none;
        border-radius: 999px;
        box-sizing: border-box;
        display: grid;
        place-items: center;
        height: var(--height);
        -webkit-mask-image: none;
        padding: 0 3rem;
        position: relative;
        text-transform: uppercase;
    }
    .btn-79  {
        font-weight: 900;
        mix-blend-mode: difference!important;
    }

    .span{
        z-index:1000 !important;
    }
    .btn-79:before {
        background: #34568b;
        border-radius: 20px;
        content: "";
        height: calc(var(--height) / 1.7);
        left: 0;
        pointer-events: none;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        transition: 0.2s;
        width: calc(var(--height) / 1.7);
    }
    .btn-79:hover:before {
        left: 0;
        width: 100%;
    }

    #addBtn{
        background-color: #34568b;!important;
        color: white;!important;
        border-radius: 1px;
        border: none;
        font-weight: bolder;
        font-family: 'Assistant-Regular', sans-serif;
        padding: 8px;
        float: right;
        margin-bottom: 10px;
        margin-right: 10px;
        /*box-shadow: rgba(0, 0, 0, 0.06) 0px 2px 4px 0px inset;*/
        box-shadow: rgba(50, 50, 93, 0.2) 0px 40px 80px -20px, rgba(0, 0, 0, 0.25) 0px 20px 50px -30px, rgba(10, 37, 64, 0.3) 0px -2px 4px 0px inset;
    }

    #addBtn:hover{
        color: #FFFFFF;
        font-weight: bolder;
        /*padding: 10.5px;*/
        margin-bottom: 10px;
        background-color: #264c87;
        /*box-shadow: rgba(50, 50, 93, 0.25) 0px 50px 100px -20px, rgba(0, 0, 0, 0.3) 0px 30px 60px -30px, rgba(10, 37, 64, 0.35) 0px -2px 6px 0px inset;*/
    }

    #addBtn:active {
        transform: translateY(2px); /* Makes the element look like it's pressed */
        box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 4px 0px; /* Reduces shadow for 'pressed' effect */

    }
    .GridCard{
        /*padding: 20px;*/
        margin-top: 40px;
        margin-right: 8%;
        /*max-width: 95% !important;*/
        /*box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;*/
        /*background-color: rgba(171, 198, 205, 0.2) !important;*/
        /*border-radius: 10px;*/
        box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px;
        z-index: 10000;!important;
    }
    .e-grid{
        font-family: 'Assistant-Regular', sans-serif;!important;
    }

    .e-icons .e-plus{
        font-weight: bolder;!important;
        font-size: 1.2em;!important;
        text-shadow: 0px 0px 1px black;!important;
    }

    /*bar at top of table where search is*/
    .e-toolbar.e-spacer-toolbar .e-toolbar-items:not(.e-toolbar-multirow){
        background-color: #F2F2F2;
    }

    .e-grid .e-gridheader  th:not(.e-freezeleftborder,.e-freezerightborder) {
        background-color: #F5FAFD!important;
    }

    .e-headertext{
        color: #34568b !important;
    }

    /*remove blue border on focused search box*/
    .e-input-group.e-input-focus:not(.e-success):not(.e-warning):not(.e-error), .e-input-group.e-control-wrapper.e-input-focus:not(.e-success):not(.e-warning):not(.e-error){
        box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;
        border:#F2F2F2!important;
    }

    .e-input-group:not(.e-disabled):active:not(.e-success):not(.e-warning):not(.e-error), .e-input-group.e-control-wrapper:not(.e-disabled):active:not(.e-success):not(.e-warning):not(.e-error){
        box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;
        border:#F2F2F2!important;
    }
    .e-grid .e-focused:not(.e-menu-item){
        box-shadow: none;!important;
    }
    .e-flat:focus{
        border: none!important;
        outline: 0 !important;
        box-shadow: none!important;
    }

    .e-grid .e-pager{
        background-color: #f5f7f8;
    }


    .e-input-group input.e-input, .e-input-group.e-control-wrapper input.e-input .e-focused{
        border: none!important;
    }


    .e-grid td.e-rowcell.e-focus.e-focused {
        box-shadow: none !important;
    }


    .e-grid td.e-groupcaption .e-focus.e-focused {
        box-shadow: none !important;
    }


    .e-grid th.e-headercell.e-focus.e-focused {
        box-shadow: none !important;
    }

    /*page arrows next*/
    .e-pager div.e-icons.e-pager-default{
        color: #34568b;
    }
    /*page arrows previous*/
    .e-pager.sf-pager .e-pagercontainer .e-prev{
        color: #34568b;
    }
    /*page numbers*/
    .e-pager.sf-pager .e-numericcontainer a{
        color: #34568b;
    }
    .e-link .e-numericitem .e-spacing .e-currentitem .e-active{
        box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;
        border:#F2F2F2!important;
    }

    .e-pager .e-currentitem.e-numericitem.e-focused{
        box-shadow: rgba(0, 0, 0, 0.16) 0px 3px 6px, rgba(0, 0, 0, 0.23) 0px 3px 6px;
        background: #FBFBFB;
    }

    .e-pager .e-currentitem, .e-pager .e-currentitem:hover{
        border-right-color: #34568b;
        background: #FBFBFB;
    }

    .e-pager .e-currentitem {
        border: 2px solid #34568b;
    }

    .e-grid .e-focused:not(.e-menu-item):not(.e-editedbachcell){
        box-shadow: none;
        border: none;
    }

    .e-headertext{
        color: #34568b;
    }
</style>
<PageTitle>Customer Records</PageTitle>
<AuthorizeView>
    <Authorized>
        <SfButton id="BackBtn" @onclick="GoBack" CssClass="btn-79" IconPosition="IconPosition.Left"><bold style="z-index: 1000 !important;">Go Back</bold>
        </SfButton>

        <label class="selected-name-customrec">
            <strong>@SelectedRow.CONTACT_NAME</strong>
        </label>
        
        @* <label style="margin-left:10px;font-size:20px;"> *@
        @*     <strong>@SelectedRow.CONTACT_NAME</strong> *@
        @* </label> *@

        @if (IsLoading)
        {
            <SfSkeleton CssClass="skeleton-default" Shape=Syncfusion.Blazor.Notifications.SkeletonType.Rectangle Width="100%"
                        Height="80vh"></SfSkeleton>
        }
        else
        {
            @if (!_isEdit)
            {
                <div>
                    <div style="float:left">
                        <h3 class="page-title-customrec">Customer Records</h3>
                    </div>
                    
                    <div style="float: right">
                        <SfButton id="addBtn" @onclick="AddUser" IconPosition="IconPosition.Left"
                                  IconCss="e-icons e-plus" CssClass="e-custom-remove">Add User
                        </SfButton>
 
                    </div>
                </div>
                
                
                
                
                @* <SfButton id="addBtn" @onclick="AddUser" IconPosition="IconPosition.Left" *@
                @*           IconCss="e-icons e-plus" CssClass="e-custom-remove">Add User *@
                @* </SfButton> *@
                @* <h3>Customer's Records</h3> *@
                
                <div style="padding-bottom:200px">
                    <SfCard CssClass="GridCard">
                    <SfGrid ID="Grid"
                            @ref="Grid"
                            TValue="SalesProfileModel"
                            Toolbar="@_toolBar"
                            DataSource="@_users"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowSelection="true"
                            AllowFiltering="true"
                            AllowExcelExport="true"
                            AllowPdfExport="false"

                            Height="500"
                            Width="Auto">
                        <GridPageSettings PageCount="10" PageSize="@_pageSize"></GridPageSettings>
                        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                        <GridEditSettings Mode="EditMode.Normal" AllowEditing="true"></GridEditSettings>
                        <GridEvents RowSelected="OnRowSelected" PageChanged="PageChangedHandler"
                                    CommandClicked="OnCommandClicked" OnToolbarClick="DataToolbarClickHandler"
                                    TValue="SalesProfileModel"></GridEvents>
                        <GridColumns>
                            @* <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn> *@
                            <GridColumn Field=@nameof(SalesProfileModel._id) HeaderText="_id" IsPrimaryKey="true" Visible="false"
                                        TextAlign="TextAlign.Left" 
                                        Type="ColumnType.String"></GridColumn>
                            
                            <GridColumn TextAlign="TextAlign.Center" Width="3%" >
                                <Template Context="UserModel">
                                    @{
                                        /*<div class="image">
                                            <img src="@((UserModel as UserModel).ImageURL)" alt="User Image"/>
                                        </div>*/
                                    }
                                </Template>
                            </GridColumn>

                            <GridColumn Field=@nameof(SalesProfileModel.ACCOUNT_REF) HeaderText="Account Ref" TextAlign="TextAlign.Left"
                                        Width="20%" AllowEditing="false"
                                        Type="ColumnType.String"></GridColumn>
                            <GridColumn Field=@nameof(SalesProfileModel.NAME) HeaderText="Name" TextAlign="TextAlign.Left"
                                        Width="20%" AllowEditing="false"
                                        Type="ColumnType.String"></GridColumn>
                            <GridColumn Field=@nameof(SalesProfileModel.CONTACT_NAME) HeaderText="Contact Name" TextAlign="TextAlign.Left"
                                        Width="20%" AllowEditing="false"
                                        Type="ColumnType.String"></GridColumn>
                            <GridColumn Field=@nameof(SalesProfileModel.TELEPHONE) HeaderText="Telephone" TextAlign="TextAlign.Left"
                                        Width="20%" AllowEditing="false"
                                        Type="ColumnType.String"></GridColumn>

                            <GridColumn HeaderText="Manage Records" Width="150">
                                <GridCommandColumns>
                                    <GridCommandColumns>
                                        <GridCommandColumn
                                            ButtonOption="@(new CommandButtonOptions { Content = "Edit", CssClass = "e-success" })"></GridCommandColumn>
                                        <GridCommandColumn
                                            ButtonOption="@(new CommandButtonOptions { Content = "Delete", CssClass = "e-danger" })"></GridCommandColumn>
                                    </GridCommandColumns>
                                </GridCommandColumns>
                            </GridColumn>
                        </GridColumns>
                        <SfSpinner @bind-Visible="IsLoading">
                        </SfSpinner>
                    </SfGrid>
                    </SfCard>
                </div>
            }

            @* @if (SelectedRow != null && _isEdit && !_isAddUser) *@
            @* { *@
            @*     <DynamicComponent Type="@SelectedComponent" Parameters="@ComponentParameters"/> *@
            @* } *@
            @* *@
            @* @if (_isAddUser) *@
            @* { *@
            @*     <AddUser /> *@
            @* } *@
        }

    </Authorized>
    <NotAuthorized>
        <p>Not Authorized</p>
    </NotAuthorized>
</AuthorizeView>


