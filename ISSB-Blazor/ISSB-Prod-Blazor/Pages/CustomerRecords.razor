    private async Task GoBack()
    {
        _isEdit = false;
        _isAddUser = false;
        if (RowIndex > 0)
        {
            IsLoading = true;
            SelectedRow.CONTACT_NAME = string.Empty;
            var usrService = new SalesProfileService();
            _users = await usrService.GetSalesProfiles();
            IsLoading = false;
            _isEdit = false;
         
            await InvokeAsync(() => { StateHasChanged(); });
            await Task.Delay(500);
            await Grid.GoToPageAsync(PageIndex);

            var rowForPage = RowIndex / PageIndex;
            await Grid.SelectRowAsync(SelectedRowIndexOnPage - 1);

            if (SelectedRowIndexOnPage >= 0)
            {
                await Grid.ScrollIntoViewAsync(SelectedRowIndexOnPage - 1);
            }
        }
    }

