@code {
    private System.Timers.Timer? timer; // Timer for refreshing the time
    private DateTime currentTime;      // Current time displayed on the clock
  
    
    // Calculated rotation angles for the clock hands
    public double HourRotation => (currentTime.Hour % 12) * 30 + (currentTime.Minute / 60.0) * 30; // Degrees = hours * 30 + minute-adjusted degrees
    public double MinuteRotation => currentTime.Minute * 6 + (currentTime.Second / 60.0) * 6;       // Degrees = minutes * 6 + second-adjusted degrees
    public double SecondRotation => currentTime.Second * 6;                                        // Degrees = seconds * 6

    protected override void OnInitialized()
    {
        currentTime = DateTime.Now;

        // Initialize timer (fires every second)
        timer = new System.Timers.Timer(1000);
        timer.Elapsed += UpdateTime; // Attach the handler to update the clock
        timer.Start();
    }

    private void UpdateTime(object? sender, System.Timers.ElapsedEventArgs e)
    {
        currentTime = DateTime.Now; // Update the current time
        InvokeAsync(StateHasChanged); // Refresh the UI on the main thread
    }

    // Proper disposal of the timer to prevent memory leaks
    public void Dispose()
    {
        timer?.Dispose();
    }
