    .login-logo-img {
        max-width: 160px;      /* adjust size to match design */
        height: auto;
        display: block; 
        padding-bottom: 10px;
    }

    /* layout */
    .landing{
        width:100%;
        margin:24px auto;
        padding:0 16px;
        max-width:1200px;
    }

    /* card */
    .card{
        background:#fff;
        border:1px solid #e6edf6;
        border-radius:12px;
        box-shadow:0 6px 18px rgba(52,86,139,.01);
        padding:30px 32px;
        margin-bottom:22px;
        display:block;
        width:90%;
    }

    /* accent bar */
    .card--accent{ position:relative; }
    .card--accent::before{
        content:"";
        position:absolute; left:0; top:0;
        height:4px; width:100%;
        border-radius:12px 12px 0 0;
        background:linear-gradient(90deg,#34568B,#6f8fb8 60%,rgba(13,202,240,.45));
    }

    /* inner layout */
    .card--full{
        display:flex;
        justify-content:space-between;
        gap:24px;
        align-items:flex-start;
        height:auto;
    }
    .card__left{ flex:1 1 auto; }
    .card__right{ flex:0 0 auto; display:flex; flex-direction:column; gap:10px; align-items:flex-start; }
    .btn-col .link{ margin-left:4px; }

    /* tighter spacing */
    .card--tight .title{ margin:2px 0 6px; }
    .card--tight .h2{ margin:0 0 6px; }
    .card--tight .muted{ margin:0 0 8px; }

    /* type */
    .title{ color:#34568B; font-weight:800; letter-spacing:.01em; }
    .title--xl{ font-size:2.4rem; line-height:1.15;padding-bottom: 10px  }
    .h2{ color:#34568B; font-weight:800; font-size:1.6rem; }
    .h2--underline{ position:relative; padding-bottom:4px; }
    .h2--underline::after{
        content:""; position:absolute; left:0; bottom:0;
        width:48px; height:3px; border-radius:2px; background:#34568B; opacity:.75;
    }
    .muted{ color:#6C757D; }

    /* key/value */
    .kv{ display:grid; gap:6px; margin:6px 0 0; }
    .kv dt{ color:#34568B; font-weight:700; }
    .kv dd{ margin:0; }

    /* tags */
    .tag{ display:inline-block; padding:2px 10px; border-radius:999px; font-size:.85rem; border:1px solid transparent; }
    .tag--ok{ color:#2f6f3a; background:#e9f6ee; border-color:#cfead7; }

    /* primary button */
    .data-button{
        background:#fff; color:#34568B; border:2px solid #34568B;
        border-radius:1px; font-weight:700; font-family:'Assistant-Regular',sans-serif;
        padding:10px 24px; font-size:15px; display:inline-flex; align-items:center; justify-content:center;
        cursor:pointer; transition:all .2s ease-in-out; margin:4px 0 2px;
        padding-bottom: 10px;
    }
.data-button:hover{
    background-color: rgba(52, 86, 139, 0.1);
    color: #34568B;
    box-shadow: none;
    border: 1px solid #34568B;
}

    .link{ color:#34568B; text-decoration:none; font-weight:600; }
    .link:hover{ text-decoration:underline; }

    /* timeline */
    .timeline{
        list-style:none; margin:10px 0 12px; padding:0; display:grid; gap:14px; position:relative;
    }
    .timeline li{
        display:grid; grid-template-columns:16px 1fr; gap:10px; position:relative;
    }
    .tl-dot{
        width:10px; height:10px; border-radius:50%; margin-top:6px; display:inline-block;
    }
    .tl-dot--add{ background:#2e7d32; }
    .tl-dot--edit{ background:#34568B; }
    .tl-dot--del{ background:#9c2b2b; } /* switch to #6f8fb8 if avoiding red */
    .tl-body p{ margin:0; }
    .tl-body time{ color:#6C757D; font-size:.9rem; }

    /* responsive */
    @@media (max-width:1100px){
        .card--full{ flex-direction:column; }
        .card__right{ width:100%; flex:0 0 auto; align-items:flex-start; }
    }

