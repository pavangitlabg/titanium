</style>

<PageTitle>Import File Types</PageTitle>
<AuthorizeView>
    <Authorized>
        @* <SfButton id="BackBtn" @onclick="GoBack" CssClass="e-custom-back" IconPosition="IconPosition.Left" *@
        @*           IconCss="e-icons e-chevron-left-double">Back *@
        @* </SfButton> *@
        <SfButton id="BackBtn" @onclick="GoBack" CssClass="btn-79" IconPosition="IconPosition.Left"><bold style="z-index: 1000 !important;">Go Back</bold>
        </SfButton>
        <HubMessage/>
        <label class="selected-name">
            <strong>@SelectedRow.NAME</strong>
        </label>
        
        @if (IsLoading)
        {
            <SfSkeleton CssClass="skeleton-default" Shape=SkeletonType.Rectangle Width="100%"
                        Height="80vh"></SfSkeleton>
        }
        else
        {
                <div>
                    <div style="float:left">
                        <h3 class="page-title">Imported File Types</h3>
                    </div>
                    
                    <div style="float: right">
                        <SfButton id="uploadBtn" @onclick="HandleAddType" IconPosition="IconPosition.Left"
                                  IconCss="e-icons e-plus" CssClass="e-custom-remove">Add File Type
                        </SfButton>
                    </div>
                </div>
                
                <div style="padding-bottom:200px">
                <SfCard CssClass="GridCard">
                    <SfGrid ID="Grid"
                            @ref="Grid"
                            TValue="ImportFileTypeModel"
                            Toolbar="@_toolBar"
                            DataSource="@_modelList"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowSelection="true"
                            AllowFiltering="false"
                            AllowExcelExport="true"
                            AllowPdfExport="false"
                            Height="500"
                            Width="Auto">
                        <GridPageSettings PageCount="10" PageSize="@_pageSize"></GridPageSettings>
                        <GridFilterSettings Type="FilterType.Excel"></GridFilterSettings>
                        <GridEditSettings Mode="EditMode.Normal" AllowEditing="true"></GridEditSettings>
                        <GridEvents RowSelected="OnRowSelected" PageChanged="PageChangedHandler"
                                    CommandClicked="OnCommandClicked" OnToolbarClick="DataToolbarClickHandler"
                                    TValue="ImportFileTypeModel"></GridEvents>
                        <GridColumns>
                            @* <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn> *@
                            <GridColumn Field=@nameof(ImportFileTypeModel._id) HeaderText="_id" IsPrimaryKey="true" Visible="false"
                                        TextAlign="TextAlign.Left" 
                                        Type="ColumnType.String"></GridColumn>
                            <GridColumn Field=@nameof(ImportFileTypeModel.KEY) HeaderText="Key"
                                        TextAlign="TextAlign.Left" Width="15%" AllowEditing="false"
                                        Format="dd-MM-yyyy" Type="ColumnType.Date"></GridColumn>
                            <GridColumn Field=@nameof(ImportFileTypeModel.NAME) HeaderText="Name" TextAlign="TextAlign.Left"
                                        Width="20%" AllowEditing="false"
                                        Type="ColumnType.String"></GridColumn>
                            
                            <GridColumn HeaderText="Manage Records" Width="20%">
                                <GridCommandColumns>
                                    <GridCommandColumns>
                                        <GridCommandColumn
                                            ButtonOption="@(new CommandButtonOptions { Content = "Edit", CssClass = "e-success" })"></GridCommandColumn>
                                        <GridCommandColumn
                                            ButtonOption="@(new CommandButtonOptions { Content = "Delete", CssClass = "e-danger" })"></GridCommandColumn>
                                    </GridCommandColumns>
                                </GridCommandColumns>
                            </GridColumn>
                        </GridColumns>
                        <SfSpinner @bind-Visible="IsLoading">
                        </SfSpinner>
                    </SfGrid>
                </SfCard>
                </div>

                <SfDialog Width="400px" IsModal="true" @bind-Visible="@IsDeleteDialogVisible">
                    <DialogTemplates>
                        <Header>Confirm Delete</Header>
                        <Content>
                            Are you sure you want to delete this file type?
                        </Content>
                    </DialogTemplates>
                    <DialogButtons>
                        <DialogButton Content="No" OnClick="@(() => IsDeleteDialogVisible = false)"/>
                        <DialogButton Content="Yes" IsPrimary="true" OnClick="@HandleDelete"/>
                    </DialogButtons>
                </SfDialog>
                
            <SfDialog Width="80%" IsModal="true" @bind-Visible="@IsDialogVisible">
                
                <DialogTemplates>
                    <Header>File Type</Header>
                    <Content>
                        <div>
                            <div class="form-group">
                                <div class="form-row">
                                    <div class="col-md-6">
                                        <SfTextBox @bind-Value="@SelectedRow.KEY"
                                                   Placeholder="Enter Key"
                                                   FloatLabelType="@FloatLabelType.Auto">
                                        </SfTextBox>
                                        @if (string.IsNullOrEmpty(SelectedRow.KEY))
                                        {
                                            <div class="validation-message">Key is required</div>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <SfTextBox @bind-Value="@SelectedRow.NAME"
                                                   Placeholder="Enter Name"
                                                   FloatLabelType="@FloatLabelType.Auto">
                                        </SfTextBox>
                                        @if (string.IsNullOrEmpty(SelectedRow.NAME))
                                        {
                                            <div class="validation-message">Name is required</div>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            <h4 style="color: red">@_errorMessage</h4>
                        </div>
                    </Content>
                </DialogTemplates>
                <DialogButtons>
                    <DialogButton Content="Cancel" OnClick="@(() => IsDialogVisible = false)"/>
                    @if (!_isAdd)
                    {
                        <DialogButton Content="Update" IsPrimary="true" OnClick="@HandleUpload"/>
                    }
                    else
                    {
                        <DialogButton Content="Add" IsPrimary="true" OnClick="@HandleAdd"/>
                    }
                  
                </DialogButtons>
            </SfDialog>
        }

    </Authorized>
    <NotAuthorized>
        <p>Not Authorized</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    List<ImportFileTypeModel> _modelList { get; set; } = new();
    SfGrid<ImportFileTypeModel> Grid { get; set; }
    
    private List<object> _toolBar = new() { "ExcelExport", "Search" };
    private bool IsLoading { get; set; } = true;
    private string _errorMessage = string.Empty;

    private ImportFileTypeModel SelectedRow { get; set; } = new();
    private Dictionary<string, object> ComponentParameters { get; set; }
    private bool IsDialogVisible { get; set; } = false;
    private bool IsDeleteDialogVisible { get; set; } = false;
    private int RowIndex { get; set; }
    private int SelectedRowIndexOnPage { get; set; }
    private int PageIndex { get; set; }
    private int _pageSize = 15;
    private bool _isAdd = false;

    public void Dispose()
    {
        Grid?.Dispose();
    }

    private void HandleAddType()
    {
        _isAdd = true;
        SelectedRow = new();
        IsDialogVisible = true;
    }
    
    private async Task HandleUpload()
    {
        if (string.IsNullOrEmpty(SelectedRow.KEY))
        {
           _errorMessage = "Invalid Key";
           return;
        }

        if (string.IsNullOrEmpty(SelectedRow.NAME))
        {
            _errorMessage = "Invalid Name";
            return;
        }
        await ImportFileTypeService.Save(SelectedRow);
        IsDialogVisible = false;
        await GetData();
    }
    
    private async Task HandleAdd()
    {
        if (string.IsNullOrEmpty(SelectedRow.KEY))
        {
            _errorMessage = "Invalid Key";
            return;
        }

        if (string.IsNullOrEmpty(SelectedRow.NAME))
        {
            _errorMessage = "Invalid Name";
            return;
        }
        await ImportFileTypeService.Add(SelectedRow);
        IsDialogVisible = false;
        _isAdd = false;
        await GetData();
    }
    
    public void PageChangedHandler(GridPageChangedEventArgs args)
    {
        PageIndex = args.CurrentPage;
    }

    private void OnRowSelected(RowSelectEventArgs<ImportFileTypeModel> args)
    {
        SelectedRow = args.Data;
        RowIndex = args.RowIndex; // Global index
        SelectedRowIndexOnPage = args.RowIndex % _pageSize + 1; // Index within current page
    }
    

    private async Task GoBack()
    {
        // _isEdit = false;
        // _isAddUser = false;
        // if (RowIndex > 0)
        // {
        //     IsLoading = true;
        //     SelectedRow.CompanyName = string.Empty;
        //     _imports = await UserServices.GetUsersAsync();
        //     IsLoading = false;
        //     _isEdit = false;
        //  
        //     await InvokeAsync(() => { StateHasChanged(); });
        //     await Task.Delay(500);
        //     await Grid.GoToPageAsync(PageIndex);
        //
        //     var rowForPage = RowIndex / PageIndex;
        //     await Grid.SelectRowAsync(SelectedRowIndexOnPage - 1);
        //
        //     if (SelectedRowIndexOnPage >= 0)
        //     {
        //         await Grid.ScrollIntoViewAsync(SelectedRowIndexOnPage - 1);
        //     }
        // }
    }

    public async void OnCommandClicked(CommandClickEventArgs<ImportFileTypeModel> args)
    {
        if (args.CommandColumn.ButtonOption.Content.Equals("Delete"))
        {
        SelectedRow = args.RowData;
        IsDeleteDialogVisible = true;
        await InvokeAsync(StateHasChanged);
        }

        if (args.CommandColumn.ButtonOption.Content.Equals("Edit"))
        {
            SelectedRow = args.RowData;
            IsDialogVisible = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task DataToolbarClickHandler(ClickEventArgs args)
    {
        if (args.Item.Text == "Excel Export")
        {
            await Grid.ExportToExcelAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
           await GetData();
        }
    }

    private async Task GetData()
    {
        IsLoading = true;
        _modelList = await ImportFileTypeService.GetFileTypes();
        IsLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleDelete()
    {
        await ImportFileTypeService.Delete(SelectedRow);
        IsDeleteDialogVisible = false;
        SelectedRow = new();
        await GetData();
    }

}