<PageTitle>Import Files</PageTitle>
<AuthorizeView>
    <Authorized>
        @* <SfButton id="BackBtn" @onclick="GoBack" CssClass="e-custom-back" IconPosition="IconPosition.Left" *@
        @*           IconCss="e-icons e-chevron-left-double">Back *@
        @* </SfButton> *@
        <SfButton id="BackBtn" @onclick="GoBack" CssClass="btn-79" IconPosition="IconPosition.Left"><bold style="z-index: 1000 !important;">Go Back</bold>
        </SfButton>
        <HubMessage/>
        <label class="selected-name">
            <strong>@SelectedRow.FileName</strong>
        </label>
        
        @if (IsLoading)
        {
            <SfSkeleton CssClass="skeleton-default" Shape=SkeletonType.Rectangle Width="100%"
                        Height="80vh"></SfSkeleton>
        }
        else
        {
            @if (!_isEdit)
            {
                
                <div>
                    <div style="float:left">
                        <h3 class="page-title">Imported Files</h3>
                    </div>
                    
                    <div style="float: right">
                        <SfButton id="uploadBtn" @onclick="UploadFile" IconPosition="IconPosition.Left"
                                  IconCss="e-icons e-plus" CssClass="e-custom-remove">Upload New File
                        </SfButton>
                    </div>
                </div>
                
                <div style="padding-bottom:200px">
                <SfCard CssClass="GridCard">
                    <SfGrid ID="Grid"
                            @ref="Grid"
                            TValue="DataFileImportModel"
                            Toolbar="@_toolBar"
                            DataSource="@_modelList"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowSelection="true"
                            AllowFiltering="false"
                            AllowExcelExport="true"
                            AllowPdfExport="false"
                            Height="500"
                            Width="Auto">
                        <GridPageSettings PageCount="10" PageSize="@_pageSize"></GridPageSettings>
                        <GridFilterSettings Type="FilterType.Excel"></GridFilterSettings>
                        <GridEditSettings Mode="EditMode.Normal" AllowEditing="true"></GridEditSettings>
                        @* <GridEvents RowSelected="OnRowSelected" PageChanged="PageChangedHandler" *@
                        @*             CommandClicked="OnCommandClicked" OnToolbarClick="DataToolbarClickHandler" *@
                        @*             TValue="DataFileImportModel"></GridEvents> *@
                        <GridColumns>
                            @* <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn> *@
                            <GridColumn Field=@nameof(DataFileImportModel._id) HeaderText="_id" IsPrimaryKey="true" Visible="false"
                                        TextAlign="TextAlign.Left" 
                                        Type="ColumnType.String"></GridColumn>
                            <GridColumn Field=@nameof(DataFileImportModel.Date) HeaderText="Date"
                                        TextAlign="TextAlign.Left" Width="15%" AllowEditing="false"
                                        Format="dd-MM-yyyy" Type="ColumnType.Date"></GridColumn>
                            <GridColumn Field=@nameof(DataFileImportModel.Source) HeaderText="Source" TextAlign="TextAlign.Left"
                                        Width="20%" AllowEditing="false"
                                        Type="ColumnType.String"></GridColumn>
                            <GridColumn Field=@nameof(DataFileImportModel.FileName) HeaderText="File Name" TextAlign="TextAlign.Left"
                                        Width="20%" AllowEditing="false"
                                        Type="ColumnType.String"></GridColumn>
                            <GridColumn Field=@nameof(DataFileImportModel.Subject) HeaderText="Subject" TextAlign="TextAlign.Left"
                                        Width="20%" AllowEditing="false"
                                        Type="ColumnType.String"></GridColumn>
                            
                            <GridColumn HeaderText="Manage Records" Width="20%">
                                <GridCommandColumns>
                                    <GridCommandColumns>
                                        <GridCommandColumn
                                            ButtonOption="@(new CommandButtonOptions { Content = "Edit", CssClass = "e-success" })"></GridCommandColumn>
                                        <GridCommandColumn
                                            ButtonOption="@(new CommandButtonOptions { Content = "Delete", CssClass = "e-danger" })"></GridCommandColumn>
                                    </GridCommandColumns>
                                </GridCommandColumns>
                            </GridColumn>
                        </GridColumns>
                        <SfSpinner @bind-Visible="IsLoading">
                        </SfSpinner>
                    </SfGrid>
                </SfCard>
                </div>
            }

            <SfDialog Width="80%" IsModal="true" @bind-Visible="@IsDialogVisible">
                <DialogTemplates>
                    <Header>Upload File</Header>
                    <Content>
                        <div>
                            @* <div class="form-group" style="margin-bottom: 1rem;"> *@
                            @*      *@
                            @*     <label for="sourceInput">Source</label> *@
                            @*     <SfTextBox ID="sourceInput" *@
                            @*                @bind-Value="Source" *@
                            @*                Placeholder="Enter source"> *@
                            @*     </SfTextBox> *@
                            @* *@
                            @*     <label for="subjectInput">Subject</label> *@
                            @*     <SfTextBox ID="subjectInput" *@
                            @*                @bind-Value="Subject" *@
                            @*                Placeholder="Enter subject"> *@
                            @*     </SfTextBox> *@
                            @* </div> *@

                            <SfUploader ID="UploadFiles"
                                        AllowMultiple="true"
                                        MaxFileSize="10485760"
                                        AllowedExtensions=".zip"
                                        AutoUpload="false">
                                <UploaderEvents ValueChange="OnFileSelected"></UploaderEvents>
                            </SfUploader>
                            <h4 style="color: red">@_errorMessage</h4>
                        </div>
                    </Content>
                </DialogTemplates>
                <DialogButtons>
                    <DialogButton Content="Cancel" OnClick="@(() => IsDialogVisible = false)"/>
                    @* <DialogButton Content="Upload" IsPrimary="true" OnClick="@HandleUpload"/> *@
                </DialogButtons>
            </SfDialog>

            @if (SelectedRow != null && _isEdit && !_isAddUser)
            {
                <DynamicComponent Type="@SelectedComponent" Parameters="@ComponentParameters"/>
            }
            
            @* @if (_isAddUser) *@
            @* { *@
            @*     <AddUser /> *@
            @* } *@
        }

    </Authorized>
    <NotAuthorized>
        <p>Not Authorized</p>
    </NotAuthorized>
</AuthorizeView>

