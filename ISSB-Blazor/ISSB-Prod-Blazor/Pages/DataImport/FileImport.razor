<style>

    .skeleton-default .col-sm-6 {
        padding: 20px;
        min-height: 150px;
        position: relative;
    }

    .skeletonRectangleMediumRight {
        float: right;
    }

    .skeletonRectangleMedium {
        float: left;
    }

    .image img {
        height: 55px;
        width: 55px;
        border-radius: 50px;
        box-shadow: inset 0 0 1px #e0e0e0, inset 0 0 14px rgba(0, 0, 0, 0.2);
    }
    
    .btn-79,
    .btn-79 *,
    .btn-79 :after,
    .btn-79 :before,
    .btn-79:after,
    .btn-79:before {
        border: 0 solid;
        box-sizing: border-box;
    }
    .btn-79.e-btn:focus,
    .btn-79.e-btn:active {
        border: none !important;
        box-shadow: none !important;
    }


    .btn-79 .e-btn :hover{
        /*color: #385273 !important;*/
        color: #a89f9f!important;
    }

    .btn-79 {
        -webkit-tap-highlight-color: transparent;
        -webkit-appearance: button;
        background-color: #FFFFFF !important;
        background-image: none;
        /*color: #079CAC!important;*/
        color: #a89f9f!important;
        cursor: pointer;
        font-family: 'Assistant-Regular', sans-serif;
        font-size: 100%;
        font-weight: 900;
        line-height: 1.5;
        margin: 0;
        -webkit-mask-image: -webkit-linear-gradient(#6f8fb8, #0dcaf0);
        padding: 0;
    }
    .btn-79:disabled {
        cursor: default;
    }
    .btn-79:-moz-focusring {
        outline: auto;
    }
    .btn-79 svg {
        display: block;
        vertical-align: middle;
    }
    .btn-79 [hidden] {
        display: none;
    }
    .btn-79 {
        --height: 60px;
        background: none;
        border-radius: 999px;
        box-sizing: border-box;
        display: grid;
        place-items: center;
        height: var(--height);
        -webkit-mask-image: none;
        padding: 0 3rem;
        position: relative;
        text-transform: uppercase;
    }
    .btn-79  {
        font-weight: 900;
        mix-blend-mode: difference!important;
    }

    .span{
        z-index:1000 !important;
    }
    .btn-79:before {
        background: #34568b;
        border-radius: 20px;
        content: "";
        height: calc(var(--height) / 1.7);
        left: 0;
        pointer-events: none;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        transition: 0.2s;
        width: calc(var(--height) / 1.7);
    }
    .btn-79:hover:before {
        left: 0;
        width: 100%;
    }

    #addBtn{
        background-color: #34568b;!important;
        color: white;!important;
        border-radius: 1px;
        border: none;
        font-weight: bolder;
        font-family: 'Assistant-Regular', sans-serif;
