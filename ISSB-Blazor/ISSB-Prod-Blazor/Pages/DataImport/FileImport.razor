    private async Task HandleUpload()
    {
        try
        {
            // if (string.IsNullOrEmpty(Source))
            // {
            //     _errorMessage = "Source is required";
            //     return;
            // }
            //
            // if (string.IsNullOrEmpty(Subject))
            // {
            //     _errorMessage = "Subject is required";
            //     return;
            // }

            if (selectedFile == null)
            {
                status = "Please select a file first.";
                return;
            }

            // Destination folder
            var uploadFolder = Path.Combine(Env.WebRootPath, "uploads");
            Directory.CreateDirectory(uploadFolder);

            var filePath = Path.Combine(uploadFolder, selectedFile.Name);

            // Copy file stream to destination
            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 100_000_000);
            await using var fs = File.Create(filePath);
            await stream.CopyToAsync(fs);

            status = $"Saved successfully to {filePath}";
            
            _errorMessage = string.Empty;
            var model = new DataFileUploadModel
            {
                Date = DateTime.Now,
                File = selectedFile.Name,
                Source = "UPLOAD",
                Subject = selectedFile.Name,
                Message = ""
            };
            var alreadyEntered = await DataImportService.DoesExitst(selectedFile.Name);

            if (alreadyEntered.FileName.Equals(selectedFile.Name))
            {
                _errorMessage = alreadyEntered.FileName + " is already on the system";
                
                File.Delete(filePath);

                return;
            }

            var mailSrv = new EmailService(DataImportService);
            var mailModel = await mailSrv.GetEmailCredentials();
            var controlSrv = new SystemControlService();
            var cntl = await controlSrv.GetSystemControl();

            if (model.File.Contains(".zip"))
            {
                var newPath = filePath.Replace(".zip", ".uploading");
                File.Move(filePath, newPath);
            }
            //Update the db

            var sysFilePath = Path.GetDirectoryName(filePath);
            var importModel = new DataFileImportModel
             {
                 Idx = cntl.LastFileNumber++,
                 Date = DateTime.Now,
                 //FileLocation = mailModel.FilePath,
                 FileLocation = sysFilePath,
                 FileName = selectedFile.Name,
                 Source = "UPLOAD",
                 FileStatus = "Uploaded",
                 Message = "",
                 Subject = model.Subject,
             };

             await DataImportService.SaveImportFile(importModel);
             cntl.LastFileNumber = cntl.LastFileNumber + 1;
             await controlSrv.UpdateControl(cntl);
             IsDialogVisible = false;
        }
        catch (Exception ex)
        {
        }
    }



