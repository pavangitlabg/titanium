@page "/SourceCountries"

<style>

    .page-title-sourcecount{
        font-family: 'Assistant-SemiBold', sans-serif;
        /*color: #a89f9f!important;*/
        color: #34568B !important;
        font-size: 15px;
        font-weight: bolder;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-top:20px;
        margin-left:10px;
    }

    .selected-country-sourcecount{
        font-family: 'Assistant-SemiBold', sans-serif;
        color: #34568B !important;
        font-size: 15px;
        font-weight: bolder;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-left:10px;
        text-decoration: underline;
        text-decoration-style: solid;
        text-decoration-thickness: 3px;
        text-underline-offset: 8px
    }

    .btn-79,
    .btn-79 *,
    .btn-79 :after,
    .btn-79 :before,
    .btn-79:after,
    .btn-79:before {
        border: 0 solid;
        box-sizing: border-box;
    }
    .btn-79.e-btn:focus,
    .btn-79.e-btn:active {
        border: none !important;
        box-shadow: none !important;
    }


    .btn-79 .e-btn :hover{
        /*color: #385273 !important;*/
        color: #a89f9f!important;
    }

    .btn-79 {
        -webkit-tap-highlight-color: transparent;
        -webkit-appearance: button;
        background-color: #FFFFFF !important;
        background-image: none;
        /*color: #079CAC!important;*/
        color: #a89f9f!important;
        cursor: pointer;
        font-family: 'Assistant-Regular', sans-serif;
        font-size: 100%;
        font-weight: 900;
        line-height: 1.5;
        margin: 0;
        -webkit-mask-image: -webkit-linear-gradient(#6f8fb8, #0dcaf0);
        padding: 0;
    }
    .btn-79:disabled {
        cursor: default;
    }
    .btn-79:-moz-focusring {
        outline: auto;
    }
    .btn-79 svg {
        display: block;
        vertical-align: middle;
    }
    .btn-79 [hidden] {
        display: none;
    }
    .btn-79 {
        --height: 60px;
        background: none;
        border-radius: 999px;
        box-sizing: border-box;
        display: grid;
        place-items: center;
        height: var(--height);
        -webkit-mask-image: none;
        padding: 0 3rem;
        position: relative;
        text-transform: uppercase;
    }
    .btn-79  {
        font-weight: 900;
        mix-blend-mode: difference!important;
    }
    
    .span{
       z-index:1000 !important;
    }
    .btn-79:before {
        background: #34568b;
        border-radius: 20px;
        content: "";
        height: calc(var(--height) / 1.7);
        left: 0;
        pointer-events: none;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        transition: 0.2s;
        width: calc(var(--height) / 1.7);
    }
    .btn-79:hover:before {
        left: 0;
        width: 100%;
    }
    
    .e-card {
        border: none !important;
        box-shadow: none;
        outline: none;
        border-radius: 0;
    }
    
    .GridCard{
        /*padding: 20px;*/
        margin-top: 40px;
        margin-right: 8%;
        /*max-width: 95% !important;*/
        /*box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;*/
        /*background-color: rgba(171, 198, 205, 0.2) !important;*/
        /*border-radius: 10px;*/
        box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px;
        z-index: 10000;!important;
        }
    
    /*.e-card{*/
    /*    -webkit-tap-highlight-color: red!important;*/
    /*}*/
.e-grid{
    font-family: 'Assistant-Regular', sans-serif;!important;
}
    #addBtn{
        background-color: #34568b;!important;
        color: white;!important;
        border-radius: 1px;
        border: none;
        font-weight: bolder;
        font-family: 'Assistant-Regular', sans-serif;
