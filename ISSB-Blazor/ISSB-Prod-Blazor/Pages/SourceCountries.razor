<PageTitle>Source Countries</PageTitle>
<AuthorizeView>
    <Authorized>
        <SfButton id="BackBtn" @onclick="GoBack" CssClass="btn-79" IconPosition="IconPosition.Left"><bold style="z-index: 1000 !important;">Go Back</bold>
        </SfButton>

        <label class="selected-country-sourcecount">
            <strong>@SelectedRow.NAME</strong>
        </label>
        

        @if (IsLoading)
        {
            <SfSkeleton CssClass="skeleton-default" Shape=Syncfusion.Blazor.Notifications.SkeletonType.Rectangle Width="100%"
                        Height="80vh"></SfSkeleton>
        }
        else
        {
            @if (!_isEdit)
            {
                <div>
                    <div style="float:left">
                        <h3 class="page-title-sourcecount">Source Countries</h3>
                    </div>
                    
                    <div style="float: right">
                        <SfButton id="addBtn" @onclick="AddCountry" IconPosition="IconPosition.Left"
                                  IconCss="e-icons e-plus" CssClass="e-custom-remove">Add Country
                        </SfButton>
 
                    </div>
                </div>
                
                <div style="padding-bottom:200px">
                    <SfCard CssClass="GridCard">
                        <SfGrid ID="Grid"
                                @ref="Grid"
                                TValue="SourceCountryModel"
                                Toolbar="@_toolBar"
                                DataSource="@_sourceCountries"
                                AllowPaging="true"
                                AllowSorting="true"
                                AllowSelection="true"
                                AllowFiltering="true"
                                AllowExcelExport="true"
                                AllowPdfExport="false"
                                Height="500"
                                Width="Auto">
                            <GridPageSettings PageCount="10" PageSize="@_pageSize"></GridPageSettings>
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                            <GridEditSettings Mode="EditMode.Normal" AllowEditing="true"></GridEditSettings>
                            <GridEvents RowSelected="OnRowSelected" PageChanged="PageChangedHandler"
                                        CommandClicked="OnCommandClicked" OnToolbarClick="DataToolbarClickHandler"
                                        TValue="SourceCountryModel"></GridEvents>
                            <GridColumns>
                                @* <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn> *@
                                <GridColumn Field=@nameof(SourceCountryModel._id) HeaderText="_id" IsPrimaryKey="true" Visible="false"
                                            TextAlign="TextAlign.Left" 
                                            Type="ColumnType.String"></GridColumn>
                                
                                <GridColumn TextAlign="TextAlign.Center" Width="3%" >
                                    <Template Context="UserModel">
                                        @{
                                            /*<div class="image">
                                                <img src="@((UserModel as UserModel).ImageURL)" alt="User Image"/>
                                            </div>*/
                                        }
                                    </Template>
                                </GridColumn>

                                <GridColumn Field=@nameof(SourceCountryModel.GEO_CODE) HeaderText="GEO Code" TextAlign="TextAlign.Left"
                                            Width="20%" AllowEditing="false"
                                            Type="ColumnType.String"></GridColumn>
                                <GridColumn Field=@nameof(SourceCountryModel.NAME) HeaderText="Name" TextAlign="TextAlign.Left"
                                            Width="40%" AllowEditing="false"
                                            Type="ColumnType.String"></GridColumn>
                                <GridColumn Field=@nameof(SourceCountryModel.REGION_NAME) HeaderText="Region Name" TextAlign="TextAlign.Left"
                                            Width="40%" AllowEditing="false"
                                            Type="ColumnType.String"></GridColumn>
                     

                                <GridColumn HeaderText="Manage Records" Width="150">
                                    <GridCommandColumns>
                                        <GridCommandColumns>
                                            <GridCommandColumn
                                                ButtonOption="@(new CommandButtonOptions { Content = "Edit", CssClass = "e-success" })"></GridCommandColumn>
                                            <GridCommandColumn
                                                ButtonOption="@(new CommandButtonOptions { Content = "Delete", CssClass = "e-danger" })"></GridCommandColumn>
                                        </GridCommandColumns>
                                    </GridCommandColumns>
                                </GridColumn>
                            </GridColumns>
                            <SfSpinner @bind-Visible="IsLoading">
                            </SfSpinner>
                        </SfGrid>
                    </SfCard>
                </div>
            }
            else
            {
                <div style="padding-bottom:200px">
                    <SfCard CssClass="SourceCountryCard">
                        <div class="container py-5">
                            <div class="row">
                                <div class="col-md-10 mx-auto">
                                    <fieldset>
                                        <div class="form-group row">
                                            <br/>
                                            <br/>
                                            <br/>
                                            <div class="col-sm-6">

                                                <label>
                                                    <strong class="sc-card-title">Active</strong>
                                                </label>
                                                <br/>
                                                <SfDropDownList @bind-Value="Country.ACTIVE" TValue="string" Width="300px" CssClass="SCDropdown"
                                                                TItem="string" Placeholder="Active" DataSource="@YesNoList">
                                                    <DropDownListFieldSettings Value="Text" Text="Text"></DropDownListFieldSettings>
                                                </SfDropDownList>
                                            </div>

                                            <div class="col-sm-3">

                                                <label>
                                                    <strong class="sc-card-title">Source Country ID</strong>
                                                </label>
                                                <SfNumericTextBox Enabled="false" Placeholder="Source Country ID" @bind-Value="@(Country.SOURCE_COUNTRY_ID)"
                                                                  FloatLabelType="FloatLabelType.Never"></SfNumericTextBox>
                                                @* <ValidationMessage For="@(() => Country.SOURCE_COUNTRY_ID)" class="text-danger" /> *@
                                            </div>

                                            <div class="col-sm-3">

                                                <label>
                                                    <strong class="sc-card-title">GEO Code</strong>
                                                </label>
                                                <SfTextBox Enabled="false" Placeholder="GEO Code" @bind-Value="@(Country.GEO_CODE)"
                                                           FloatLabelType="FloatLabelType.Never"></SfTextBox>
                                                @* <ValidationMessage For="@(() => Country.SOURCE_COUNTRY_ID)" class="text-danger" /> *@
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <br/>
                                            <br/>
                                            <br/>

                                            <div class="col-sm-6">

                                                <label>
                                                    <strong class="sc-card-title">Name</strong>
                                                </label>
                                                <br/>
                                                <SfTextBox Placeholder="Name" @bind-Value="@(Country.NAME)" CssClass="SCInput"
                                                           FloatLabelType="FloatLabelType.Never"></SfTextBox>
                                                @* <ValidationMessage For="@(() => Country.NAME)" class="text-danger" /> *@
                                            </div>

                                            <div class="col-sm-6">

                                                <label>
                                                    <strong class="sc-card-title">Region Name</strong>
                                                </label>
                                                <br/>
                                                <SfTextBox Placeholder="Region Name" @bind-Value="@(Country.REGION_NAME)" CssClass="SCInput-right"
                                                           FloatLabelType="FloatLabelType.Never"></SfTextBox>
                                                @* <ValidationMessage For="@(() => Country.REGION_NAME)" class="text-danger" /> *@
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <br/>
                                            <br/>
                                            <br/>

                                            <div class="col-sm-6">

                                                <label>
                                                    <strong class="sc-card-title">Short Legend</strong>
                                                </label>
                                                <br/>
                                                <SfTextBox Placeholder="Short Legend" @bind-Value="@(Country.SHORT_LEGEND)" CssClass="SCInput"
                                                           FloatLabelType="FloatLabelType.Never"></SfTextBox>
                                                @* <ValidationMessage For="@(() => Country.SHORT_LEGEND)" class="text-danger" /> *@
                                            </div>
                                            <div class="col-sm-6">

                                                <label>
                                                    <strong class="sc-card-title">Long Legend</strong>
                                                </label>
                                                <br/>
                                                <SfTextBox Placeholder="Long Legend" @bind-Value="@(Country.LONG_LEGEND)" CssClass="SCInput-right"
                                                           FloatLabelType="FloatLabelType.Never"></SfTextBox>
                                                @* <ValidationMessage For="@(() => Country.LONG_LEGEND)" class="text-danger" /> *@
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <br/>
                                            <br/>
                                            <br/>
                                            <div class="col-sm-6">

                                                <label>
                                                    <strong class="sc-card-title">Frequency</strong>
                                                </label>

                                                <br/>
                                                <SfTextBox Placeholder="Frequency" @bind-Value="@(Country.FREQUENCY)" CssClass="SCInput"
                                                           FloatLabelType="FloatLabelType.Never"></SfTextBox>

                                            </div>
                                            <div class="col-sm-3">

                                                <label>
                                                    <strong class="sc-card-title">Latest Date</strong>
                                                </label>

                                                <SfDatePicker @bind-Value="Country.LATEST_DATE" TValue="DateTime" Placeholder="Latest Date"
                                                              Format="dd-MM-yyyy" FullScreen="true" ShowClearButton="true"></SfDatePicker>
                                            </div>

                                            <div class="col-sm-3">

                                                <label>
                                                    <strong class="sc-card-title">First Date</strong>
                                                </label>
                                                <SfDatePicker @bind-Value="Country.FIRST_DATE" TValue="DateTime" Placeholder="First Date"
                                                              Format="dd-MM-yyyy" FullScreen="true" ShowClearButton="true"></SfDatePicker>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <br/>
                                            <br/>
                                            <br/>
                                            <div class="col-sm-6">

                                                <label>
                                                    <strong class="sc-card-title">Side of Trade</strong>
                                                </label>
                                                <br/>
                                                <SfTextBox Placeholder="Side of Trade" @bind-Value="@(Country.SIDE_OF_TRADE)" CssClass="SCInput"
                                                           FloatLabelType="FloatLabelType.Never"></SfTextBox>
                                                @* <ValidationMessage For="@(() => Country.SIDE_OF_TRADE)" class="text-danger" /> *@
                                            </div>
                                            <div class="col-sm-3">

                                                <label>
                                                    <strong class="sc-card-title">Discontinued Date</strong>
                                                </label>
                                                <SfDatePicker @bind-Value="Country.GEO_CODE_DISCONTINUED_DATE" TValue="DateTime" Placeholder="Geo Code Discontinued Date"
                                                              Format="dd-MM-yyyy" FullScreen="true" ShowClearButton="true"></SfDatePicker>
                                                @* <ValidationMessage For="@(() => Country.GEO_CODE_DISCONTINUED_DATE)" class="text-danger" /> *@

                                            </div>

                                            <div class="col-sm-3">

                                                <label>
                                                    <strong class="sc-card-title">Date Format</strong>
                                                </label>
                                                <SfTextBox Placeholder="Date Format" @bind-Value="@(Country.DATA_FORMAT)"
                                                           FloatLabelType="FloatLabelType.Never"></SfTextBox>
                                                @* <ValidationMessage For="@(() => Country.DATA_FORMAT)" class="text-danger" /> *@
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            <br/>
                                            <br/>
                                            <br/>
                                            <div class="col-sm-6">

                                                <label>
                                                    <strong class="sc-card-title">Currency Code</strong>
                                                </label>
                                                <br/>
                                                <SfTextBox Placeholder="Currency Code" @bind-Value="@(Country.CURRENCY_CODE)" CssClass="SC-CC"
                                                           FloatLabelType="FloatLabelType.Never"></SfTextBox>
                                                @* <ValidationMessage For="@(() => Country.CURRENCY_CODE)" class="text-danger" /> *@
                                            </div>
                                            <div class="col-sm-6">
                                                <label>
                                                    <strong class="sc-card-title">Industry Reporting Centre ID</strong>
                                                </label>
                                                <br/>
                                                <SfNumericTextBox Placeholder="Industry Reporting Centre ID" @bind-Value="@(Country.SOURCE_COUNTRY_ID)"
                                                                  FloatLabelType="FloatLabelType.Never"></SfNumericTextBox>
                                                @* <ValidationMessage For="@(() => Country.SOURCE_COUNTRY_ID)" class="text-danger" /> *@
                                            </div>
                                        </div>


                                        <div class="form-group">
                                            <button type="submit" class="save-button"><span style="padding-left: 5px">Save &nbsp;<i class="fas fa-file-import"></i></span></button>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    </SfCard>
                </div>
            }
        }
   
    </Authorized>
    <NotAuthorized>
        <p>Not Authorized</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    SfGrid<SourceCountryModel> Grid { get; set; }
    List<SourceCountryModel> _sourceCountries = new();
    SourceCountryModel Country { get; set; } = new();
    private List<object> _toolBar = new() { "ExcelExport", "Search" };
    private bool IsLoading { get; set; } = true;
    private RenderFragment _dynamicRenderFragment;

    private SourceCountryModel SelectedRow { get; set; } = new();
    private Type SelectedComponent { get; set; }
    private Dictionary<string, object> ComponentParameters { get; set; }
    private bool _isEdit = false;
    private bool _isAddUser = false;
    private int RowIndex { get; set; }
    private int SelectedRowIndexOnPage { get; set; }
    private int PageIndex { get; set; }
    private int _pageSize = 10;
    
    List<string> YesNoList { get; set; } = new();

    public void Dispose()
    {
        Grid?.Dispose();
    }

    public void PageChangedHandler(GridPageChangedEventArgs args)
    {
        PageIndex = args.CurrentPage;
    }

    private void OnRowSelected(RowSelectEventArgs<SourceCountryModel> args)
    {
        SelectedRow = args.Data;
        RowIndex = args.RowIndex; // Global index
        SelectedRowIndexOnPage = args.RowIndex % _pageSize + 1; // Index within current page
    }

    private async Task AddCountry()
    {
        // // Set the Blazor component to load dynamically
        // SelectedComponent = typeof(AddUser);
        //
        // _isEdit = true;
        // _isAddUser = true;
    }

    private async Task GoBack()
    {
        _isEdit = false;
        _isAddUser = false;
        if (RowIndex > 0)
        {
            IsLoading = true;
            SelectedRow.NAME = string.Empty;
            var usrService = new SourceCountryService();
            _sourceCountries = await usrService.GetSourceCountries();
            IsLoading = false;
            _isEdit = false;

