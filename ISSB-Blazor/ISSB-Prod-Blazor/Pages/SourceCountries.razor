    public string ReturnUrl { get; set; }

    public async void OnCommandClicked(CommandClickEventArgs<SourceCountryModel> args)
    {
        var srv = new SourceCountryService();
        
        if (args.CommandColumn.ButtonOption.Content.Equals("Delete"))
        {
            
        }
        if (args.CommandColumn.ButtonOption.Content.Equals("Edit"))
        {
            Country = await srv.GetSourceCountryByID(args.RowData._id);

            if (Country.ACTIVE.Equals("Y"))
            {
                Country.ACTIVE = "Yes";
            }
            else
            {
                Country.ACTIVE = "No";
            }
            
            _isEdit = true;
            await InvokeAsync(() => { StateHasChanged(); });
        }
    }

    public async Task DataToolbarClickHandler(ClickEventArgs args)
    {
        if (args.Item.Text == "Excel Export")
        {
            await Grid.ExportToExcelAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsLoading = true;
            SelectedRow.NAME = string.Empty;
            var srv = new SourceCountryService();
            _sourceCountries = await srv.GetSourceCountries();
            IsLoading = false;
            _isEdit = false;
            YesNoList.Add("Yes");
            YesNoList.Add("No");
            await InvokeAsync(() => { StateHasChanged(); });
        }
    }

