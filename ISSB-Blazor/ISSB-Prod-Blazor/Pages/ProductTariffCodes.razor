    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsLoading = true;
            SelectedRow.HARMONISED_TARIFF_LONG_LEGEND = string.Empty;
         
            _tariffs = await TariffService.GetTariffsAsync();
            IsLoading = false;
