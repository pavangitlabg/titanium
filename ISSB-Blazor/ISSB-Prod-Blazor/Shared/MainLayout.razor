        Node_Id = args.NodeData.Id;
        //await InvokeAsync(() =>
        //{
        //    StateHasChanged();
        //});
    }

    public void Toggle()
    {
        SidebarToggle = !SidebarToggle;
    }

    private AuthenticationState context;
    private bool isAuthenticated;
    private readonly List<TreeData> treedata = new();

    protected override async void OnInitialized()
    {
        base.OnInitialized();
        // Get the authentication state
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        context = auth;
        // Extract user info
        //var user = authState.User;

        //context = user.Identity?.Name ?? "Anonymous";
        // isAuthenticated = context.Identity?.IsAuthenticated ?? false;
        isAuthenticated = auth.User.Identity.IsAuthenticated;

        treedata.Add(new TreeData { nodeId = "01", nodeText = "Menu", iconCss = "icon-microchip icon", hasChild = true });
        treedata.Add(new TreeData { nodeId = "01-01", nodeText = "User Accounts", iconCss = "icon-microchip icon", pid = "01" });
        treedata.Add(new TreeData { nodeId = "01-02", nodeText = "Customer Record", iconCss = "icon-microchip icon", pid = "01" });
        treedata.Add(new TreeData { nodeId = "01-03", nodeText = "Source Countries", iconCss = "icon-microchip icon", pid = "01" });
        treedata.Add(new TreeData { nodeId = "01-04", nodeText = "Market Countries", iconCss = "icon-microchip icon", pid = "01" });
        treedata.Add(new TreeData { nodeId = "01-05", nodeText = "Ports", iconCss = "icon-microchip icon", pid = "01" });
        treedata.Add(new TreeData { nodeId = "01-06", nodeText = "Product Tariff Codes", iconCss = "icon-microchip icon", pid = "01" });
        treedata.Add(new TreeData { nodeId = "01-07", nodeText = "Exchange Rates", iconCss = "icon-microchip icon", pid = "01" });
        treedata.Add(new TreeData { nodeId = "01-08", nodeText = "GEO Locations", iconCss = "icon-microchip icon", pid = "01" });
        
        treedata.Add(new TreeData { nodeId = "02", nodeText = "Queries", iconCss = "icon-microchip icon", hasChild = true });
        treedata.Add(new TreeData { nodeId = "02-01", nodeText = "Existing Queries", iconCss = "icon-microchip icon", pid = "02" });
        treedata.Add(new TreeData { nodeId = "02-02", nodeText = "Downloads", iconCss = "icon-microchip icon", pid = "02" });
        
        treedata.Add(new TreeData { nodeId = "03", nodeText = "Utilites", iconCss = "icon-microchip icon", hasChild = true });
        treedata.Add(new TreeData { nodeId = "03-01", nodeText = "Database Stats", iconCss = "icon-microchip icon", pid = "03" });
        treedata.Add(new TreeData { nodeId = "03-02", nodeText = "Component Test Page", iconCss = "icon-microchip icon", pid = "03" });
        
        treedata.Add(new TreeData { nodeId = "04", nodeText = "About", iconCss = "icon-microchip icon", hasChild = false });
      
        treedata.Add(new TreeData { nodeId = "05", nodeText = "Data Import", iconCss = "icon-microchip icon", hasChild = true });
        treedata.Add(new TreeData { nodeId = "05-01", nodeText = "Import File Types", iconCss = "icon-microchip icon", pid = "05" });
        treedata.Add(new TreeData { nodeId = "05-02", nodeText = "Data Clients", iconCss = "icon-microchip icon", pid = "05" });
        treedata.Add(new TreeData { nodeId = "05-03", nodeText = "Data File Imports", iconCss = "icon-microchip icon", pid = "05" });
        treedata.Add(new TreeData { nodeId = "05-04", nodeText = "Update Import", iconCss = "icon-microchip icon", pid = "05" });
        treedata.Add(new TreeData { nodeId = "05-05", nodeText = "Posted Import", iconCss = "icon-microchip icon", pid = "05" });
        treedata.Add(new TreeData { nodeId = "05-06", nodeText = "Data Edit", iconCss = "icon-microchip icon", pid = "05" });
    }

    //protected override async Task OnAfterRenderAsync(bool firstRender)
