@using ISSB_Prod_Blazor.Pages
@using ISSB_Prod_Blazor.Pages.DataImport
@using ISSB_Prod_Blazor.Pages.User
@using Index = Index
@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<AuthorizeView>
    <Authorized>

        <div class="col-lg-12 col-sm-12 col-md-12">
            <div class="main-header" id="header-section">
                <ul class="header-list">
                    <li class="float-left header-style icon-menu" id="hamburger" @onclick="@Toggle"></li>
                    <li class="float-left header-style nav-pane">
                        <b>
                            <a class="ISSB-Title"  href="/">ISSB Trade Enquiry Portal</a>
                        </b>
                    </li>
                    <li class="header-style float-right support border-left" style="cursor:pointer" @onclick="@Logout">
                        <b>Hello, @context.User.Identity.Name - Logout</b>
                    </li>
                </ul>
            </div>
            <!-- end of header-section -->
            <!-- sidebar element declaration -->
            <SfSidebar HtmlAttributes="@HtmlAttribute" Width="200px" EnableDock="true" DockSize="80px"
                       Target=".main-content" @ref="Sidebar" MediaQuery="(min-width:600px)"
                       @bind-IsOpen="SidebarToggle">
                <ChildContent>
                    <div class="main-menu">
                        <div>
                            <SfTreeView CssClass="main-treeview" @ref="TreeView" ExpandOn="ExpandAction.Click"
                                        TValue="TreeData">
                                <TreeViewEvents TValue="TreeData" NodeSelected="nodeSelect"></TreeViewEvents>
                                <TreeViewFieldsSettings Id="nodeId" Text="nodeText" IconCss="iconCss"
                                                        DataSource="treedata" HasChildren="hasChild" ParentID="pid">
                                </TreeViewFieldsSettings>
                            </SfTreeView>
                        </div>
                    </div>
                </ChildContent>
            </SfSidebar>
            <div class="main-content" id="main-text">
                <div class="sidebar-content">

                    @if (context.User.Identity.IsAuthenticated)
                    {
                        var userClaims = context.User.Claims.ToList();

                        if (string.IsNullOrEmpty(Node_Id))
                        {
                        }
                        else
                        {
                            switch (Node_Id)
                            {
                                case "01-01":
                                    <UsersIndex/>
                                    Node_Id = string.Empty;
                                    break;
                                case "01-02":
                                    <CustomerRecords/>
                                    break;
                                case "01-03":
                                    <SourceCountries/>
                                    break;
                                case "01-04":
                                    <MarketCountries/>
                                    break;
                                case "01-05":
                                    <Ports/>
                                    break;
                                case "01-06":
                                    <ProductTariffCodes/>
                                    break;
                                case "01-07":
                                    <ExchangeRates/>
                                    break;
                                case "01-08":
                                    <GEOCodes/>
                                    break;
                                    
                                case "02":
                                case "02-01":
                                    <QueryIndex/>
                                    break;
                                case "02-02":
                                    <ComponentTest/>
                                    break;
                                    
                                case "03-01":
                                    <DatabasePage/>
                                    break;
                                case "03-02":
                                    <ComponentTest/>
                                    break;
                                case "04-01":
                                    <Index/>
                                    break;
                                    
                                case "05-01":
                                    <ImportFileTupes/>
                                    break;
                                case "05-02":
                                    <ImportClients/>
                                    break;
                                case "05-03":
                                    <FileImport/>
                                    break;
                                case "05-04":
                                    <UpsertData/>
                                    break;
                                case "05-05":
                                    <PostedImports/>
                                    break;
                                case "05-06":
                                    <DataEdit/>
                                    break;
                                default:
                                    <Index/>
                                    break;
                            }
                        }
                    }
                </div>
            </div>
            <div class="footer">
                <div>
                    <a href="https://www.linkedin.com/company/issb-ltd/">
                        @* <img src="userimages/LinkedIn-Logo.wine.png" alt="LinkedIn Logo" class="social-icon"> *@
                        <img src="userimages/LinkedInMinimal.png" class="linkedin-icon">
                    </a>
                </div>
                <div class="footer-content">
                    <a href="" class="footer-link">About ISBB</a>
                    <a href="" class="footer-link">Menu</a>
                    <a href="" class="footer-link">Utilites</a>
                </div>
                <div class="copyright">
                    Copyright © 2025 All rights reserved - ISBB
                </div>
                <div>
                    <a href="https://issb.nathan-software.com/" target="_blank" class="privacy-button">Privacy Policy</a>
                </div>
            </div>
        </div>

        <!--<div class="page">-->
        @*@if (menuControl.IsMenu)
            {
                <main>
                    <article class="main-content">
                        @Body
                    </article>
                </main>
            }
            else
            {
                <TreeMenu />
            }*@

        <!--<TreeMenu />
        </div>-->

    </Authorized>
    <NotAuthorized>
        <div id="wrapper">
            <div class="col-lg-12 col-sm-12 col-md-12">
                <div class="main-header" id="header-section">
                    <ul class="header-list">
                        <li class="float-left header-style icon-menu" id="hamburger"></li>
                        <li class="float-left header-style nav-pane">
                            <b>ISSB Trade Enquiry Portal</b>
                        </li>
                        <li class="header-style float-right support border-left" style="cursor: pointer"
                            @onclick="@Login">
                            <b>Login</b>
                        </li>
                    </ul>
                </div>
                <div class="main-content" id="main-text">
                    <div class="sidebar-content">
                        <iframe class="sub-iframe" style="margin-top:-15px!important"
                                src="https://www.issb.co.uk/"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {

    public string HeaderText = "Header";
    public string MainContent = "Appication Content";
    SfTreeView<TreeData> TreeView;
    SfSidebar Sidebar;
   
    public bool SidebarToggle;
    public static string Node_Id { get; set; } = string.Empty;

    public class TreeData
    {
        public string nodeId { get; set; }
        public string nodeText { get; set; }
        public string iconCss { get; set; }
        public bool hasChild { get; set; }
        public string pid { get; set; }
    }

    readonly Dictionary<string, object> HtmlAttribute = new()
