    /* Calendar title (Month Year) */
    .e-calendar .e-header .e-title {
        color: #34568B;
        font-weight: bold;
        font-size: 1.1rem;
    }

    /* Navigation arrows */
    .e-calendar .e-header span {
        color: #34568B;
        transition: all 0.2s ease-in-out;
    }
    .e-calendar .e-header span:hover {
        background-color: #E9ECEF !important;
        color: #34568B !important;
        border-radius: 6px;
    }

    /* Weekday labels (Mo, Tu, We...) */
    .e-calendar .e-content thead th {
        color: #6C757D;
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* Default day cells */
    .e-calendar .e-content td span.e-day {
        color: #444;
    }

    /* Hover day */
    .e-calendar .e-content td:hover span.e-day {
        background-color: #E9ECEF !important;
        color: #fff !important;
        border-radius: 6px;
    }

    /* Selected day */
    .e-calendar .e-content td.e-selected span.e-day {
        background-color: #34568B !important;
        color: #fff !important;
        border-radius: 6px;
    }

    /* Today button (footer) */
    .e-calendar .e-btn.e-today.e-flat.e-primary {
        background-color: #fff !important;
        color: #34568B !important;
