@page
@model ISSB_Prod_Blazor.Areas.Identity.Pages.Account.UserLoginModel 
@{
    ViewData["Title"] = "Login";
}

<div class="container-fluid">
    <div class="login-box">
        <div class="login-logo">
            <a href="/Home/Index">
                <img src="/userimages/ISSB.Logo.png" alt="ISSB Logo" class="login-logo-img" />
            </a>
        </div>
        <!-- /.login-logo -->
        <div class="card">
            <div class="card-body login-card-body">
                @if (User.Identity.IsAuthenticated)
                {
                    @using (Html.BeginForm("Logout", "Auth"))
                    {
                        <p class="login-box-msg">Are you sure you want to log out?</p>
                        <div class="card-body login-card-body">
                            <div style="margin:auto; text-align:center;">
                                <input type="submit" class="btn btn-danger form-control" value="Logout"/>
                            </div>
                            <br/>
                        </div>
                    }
                }
                else
                {
                    @using (Html.BeginForm("Login", "Auth"))
                    {
                        @Html.AntiForgeryToken()
                        <p class="login-box-msg">User Login</p>
                        <div class="form-horizontal">

                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="needs-validation">
                                <div class="login-blurb">
                                    Welcome to ISSB’s Trade Enquiry System (TES). Access up-to-date trade data and insights.
                                </div>
                                <fieldset>
                                    @Html.ValidationMessageFor(u => u.loginModel.Email, "", new { @class = "text-danger" })
                                    @Html.TextBoxFor(u => u.loginModel.Email, new { @class = "form-control input-group mb-3", placeholder = "Email" })

                                    @Html.ValidationMessageFor(u => u.loginModel.Password, "", new { @class = "text-danger" })
                                    @Html.PasswordFor(u => u.loginModel.Password, new { @class = "form-control input-group mb-3", placeholder = "Password" })
                                    <div style="color: red; font-weight: bold"> @ViewData["Message"]</div>
                                    <div class="form-group">
                                        <input type="submit" class="btn btn-primary btn-md" value="Login"/>
                                        <div class="forgot-password">
                                            <a href="/Account/ForgotPassword">Forgot your password?</a>
                                        </div>
                                    </div>
                                </fieldset>
                                <br/>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
  
    :root{
        --brand:#34568B;
        --ink:#0F172A;          /* near-black */
        --muted:#6B7280;        /* gray text */
        --line:#E5E7EB;         /* hairline */
        --ring:rgba(52,86,139,.15);
    }

    .login-logo-img {
        max-width: 160px;      /* adjust size to match design */
        height: auto;
        display: block;
        margin: 0 auto 12px;   /* centers it, adds breathing room */
    }


    /* Full-bleed white, center the card with breathing room */
    .container-fluid{
        min-height:100vh;
        background:#fff;
        display:flex;
        align-items:flex-start;
        justify-content:center;
    }
    .login-box{
        width:100%;
        max-width:480px;
        margin:8vh 16px;
    }

    /* Brand wordmark */
    .login-logo a{
        display:block;
        text-align:left;
        color:var(--brand);
        text-decoration:none;
        font-weight:800;
        letter-spacing:.2px;
        font-size:28px;
        margin-bottom:18px;
    }

    /* Card: white on white, hairline border, super-light shadow */
    .card{
        background:#fff;
        border:1px solid var(--line);
        border-radius:8px;
        box-shadow:0 1px 2px rgba(15,23,42,.04);
    }
    .login-card-body{ padding:28px; }

    /* Headline */
    .login-box-msg{
        margin:0 0 12px;
        font-size:20px;
        font-weight:700;
        color:var(--ink);
        letter-spacing:.2px;
    }

    /* Blurb */
    .login-blurb{
        margin:8px 0 18px;
        color:var(--muted);
        font-size:14.5px;
        line-height:1.55;
    }

    /* Inputs: bigger targets, clean borders, clear focus ring */
    .form-control{
        height:44px;
        border-radius:10px;
        border:1px solid var(--line);
        font-size:15px;
        padding:.65rem .8rem;
        color:var(--ink);
        background:#fff;
        transition:border-color .15s, box-shadow .15s, background-color .15s;
    }
    .form-control::placeholder{ color:#9AA4B2; }
    .form-control:focus{
        border-color:var(--brand);
        box-shadow:0 0 0 4px var(--ring);
        outline:0;
    }

    /* Space out fields */
    .input-group.mb-3{ margin-bottom:14px !important; }

    /* Submit button: soft-rounded, solid brand, no gradient */
    .btn-primary{
        display:inline-block;
        width:100%;
        height:44px;
        background:var(--brand);
        letter-spacing:.2px;
        background-color: #fff;
        color: #34568B;
        border: 1px solid #34568B;
        border-radius: 1px;
        font-weight: bold;
        font-family: 'Assistant-Regular', sans-serif;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        padding-left: 13px;
        padding-right: 13px;
        padding-top: 8px;
        padding-bottom: 8px;
        margin-bottom: 10px;
        margin-right: 10px;
        box-shadow: rgba(50, 50, 93, 0.2) 0px 40px 80px -20px, rgba(0, 0, 0, 0.25) 0px 20px 50px -30px, rgba(10, 37, 64, 0.3) 0px -2px 4px 0px inset;

    }
    .btn-primary:hover{  background-color: rgba(52, 86, 139, 0.1);
        color: #34568B;
        box-shadow: none;
        border: 1px solid #34568B;}
    .btn-primary:active, .btn-primary:focus{  border: none !important;
        transform: translateY(0);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);}
    
    
    /* Logout button (if shown) aligned to modern look too */
    .btn-danger.form-control{
        height:44px; border-radius:10px; font-weight:700;
    }

    /* Forgot password link: quiet, right-aligned */
    .forgot-password{
        margin-top:10px;
        text-align:right;
        font-size:14px;
    }
    .forgot-password a{
        color:var(--brand);
        text-decoration:none;
    }
    .forgot-password a:hover{ text-decoration:underline; }

    /* Validation + message */
    .text-danger{ color:#D11A2A !important; }
    
  
</style>