@using System.Collections.Immutable
@using System.Security.Claims
@using Newtonsoft.Json
@using FilterType = Syncfusion.Blazor.Grids.FilterType
@using SkeletonType = Syncfusion.Blazor.Notifications.SkeletonType
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Query Builder</PageTitle>

<AuthorizeView>
    <Authorized>
        
        @if (IsLoading)
        {
            <SfSkeleton CssClass="skeleton-default" Shape=SkeletonType.Rectangle
                        Width="100%"
                        Height="80vh"></SfSkeleton>
        }
        else
        {
            @if (!_isEdit)
            {
                <div class="container-fluid">
                    <h3>Query Builder</h3>
                    <div class="card card-secondary" id="SC">
                        <div class="card-header">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <header id="labSourceCountries">@SourceCountryTitle</header>
                                <button type="button" class="btn btn-flat float-end"
                                        style="border: none; background: none; box-shadow: none;"
                                        @onclick="SetScVisible">
                                    <i class="@CloseScOpenIco"></i>
                                </button>
                            </div>
                        </div>
                        @if (_isScVisible)
                        {
                            <ScComponent OnMessage="HandleScSelectedMessage"  Data="Model" ReportModel="ReportModel" />
                        }
                    </div>
                    <br/>

                    <div class="card card-secondary" id="TFS">
                        <div class="card-header">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <header id="labSourceCountries">Trade Flow Section</header>
                                <button type="button" class="btn btn-flat float-end"
                                        style="border: none; background: none; box-shadow: none;"
                                        @onclick="SetTfVisible">
                                    <i class="@CloseTfOpenIco"></i>
                                </button>
                            </div>
                        </div>
                        @if(_isTfVisible)
                        {
                            <div class="card-body">
                                <TfComponent OnMessage="HandleScSelectedMessage"  Data="Model" ReportModel="ReportModel" />
                            </div>
                        }
                        </div>
                    <br/>
                    
                    <div class="card card-secondary" id="MC">
                        <div class="card-header">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <header id="labSourceCountries">@MarketCountryTitle</header>
                                <button type="button" class="btn btn-flat float-end"
                                        style="border: none; background: none; box-shadow: none;"
                                        @onclick="SetMcVisible">
                                    <i class="@CloseMcOpenIco"></i>
                                </button>
                            </div>
                        </div>
                        @if (_isMcVisible)
                        {
                            <div class="card-body">
                                <McComponent OnMessage="HandleScSelectedMessage"  Data="Model" ReportModel="ReportModel" />
                                </div>
                        }
                    </div>
                    <br/>
                    <div class="card card-secondary" id="PORT">
                        <div class="card-header">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <header id="labSourceCountries">@PortsTitle</header>
                                <button type="button" class="btn btn-flat float-end"
                                        style="border: none; background: none; box-shadow: none;"
                                        @onclick="SetPortVisible">
                                    <i class="@ClosePortOpenIco"></i>
                                </button>
                            </div>
                        </div>
                        @if (_isPortVisible)
                        {
                            <div class="card-body">
                                <PortsComponent OnMessage="HandleScSelectedMessage"  Data="Model" ReportModel="ReportModel" />
                            </div>
                        }
                    </div>
                    <br/>
                    
                    <div class="card card-secondary" id="PLS">
                        <div class="card-header">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <header id="labSourceCountries">@PlsTitle</header>
                                <button type="button" class="btn btn-flat float-end"
                                        style="border: none; background: none; box-shadow: none;"
                                        @onclick="SetPlsVisible">
                                    <i class="@ClosePlsOpenIco"></i>
                                </button>
                            </div>
                        </div>
                        @if (_isPlsVisible)
                        {
                            <div class="card-body">
                                <PLSComponent OnMessage="HandleScSelectedMessage"  Data="Model" ReportModel="ReportModel" />
                            </div>
                        }
                    </div>
                    <br/>

                    <div class="card card-secondary" id="SPS">
                        <div class="card-header">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <header id="labSourceCountries">@SpTitle</header>
                                <button type="button" class="btn btn-flat float-end"
                                        style="border: none; background: none; box-shadow: none;"
                                        @onclick="SetSpVisible">
                                    <i class="@CloseSpOpenIco"></i>
                                </button>
                            </div>
                        </div>
                        @if (_isSpVisible)
                        {
                            <div class="card-body">
                                <SpComponent OnMessage="HandleScSelectedMessage"  Data="Model" 
                                             ReportModel="ReportModel" 
                                             ProductBroad="ProductBroad"
                                             ProductMedium="ProductMediumData"
                                             TariffIndexModels="TariffIndexModel"
                                             Tariff2DigitIndexModels="Tariff2DigitIndexModel"/>
                            </div>
                        }
                    </div>
                    <br/>
                    @* Time Period Selection *@
                    <div class="card card-secondary" id="STS">
                        <div class="card-header">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <header id="labSourceCountries">@TpTitle</header>
                                <button type="button" class="btn btn-flat float-end"
                                        style="border: none; background: none; box-shadow: none;"
                                        @onclick="SetTpVisible">
                                    <i class="@CloseTpOpenIco"></i>
                                </button>
                            </div>
                        </div>
                        @if (_isTpVisible)
                        {
                            <div class="card-body">
                                <TimePeriodComponent OnMessage="HandleScSelectedMessage"  Data="Model" ReportModel="ReportModel" />
                            </div>
                        }
                    </div>
                    <br/>
                    @* Time Period Selection *@
                    <div class="card card-secondary" id="TONNES">
                        <div class="card-header">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <header id="labSourceCountries">@TonnesValueTitle</header>
                                <button type="button" class="btn btn-flat float-end"
                                        style="border: none; background: none; box-shadow: none;"
                                        @onclick="SetTonnesValueVisible">
                                    <i class="@CloseTonnesValueOpenIco"></i>
                                </button>
                            </div>
                        </div>
                        @if (_isTonnesValueVisible)
                        {
                            <div class="card-body">
                                <TonnesValuesComponent OnMessage="HandleScSelectedMessage"  Data="Model" ReportModel="ReportModel" />
                            </div>
                        }
                    </div>
                    <br/>
                    @* Save and Update *@
                    <div class="card card-secondary" id="SAVE">
                        <div class="card-header">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <header id="labSourceCountries">@SaveTitle</header>
                                <button type="button" class="btn btn-flat float-end"
                                        style="border: none; background: none; box-shadow: none;"
                                        @onclick="SetSaveUpdateVisible">
                                    <i class="@CloseSaveUpdateOpenIco"></i>
                                </button>
                            </div>
                        </div>
                        @if (_isSaveUpdateVisible)
                        {
                            <div class="card-body">
                                <SaveUpdateComponent OnMessage="HandleScSelectedMessage"  Data="Model" ReportModel="ReportModel" />
                            </div>
                        }
                    </div>
                    <br/>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <p>Not Authorized</p>
    </NotAuthorized>
</AuthorizeView>

