<div class="card-body">
    <div class="form-group">
       
            <div class="form-row">
                <div class="bar-horizontal">
                    <div class="form-group col-md-4">
                        <SfRadioButton Label="Broad Product" Name="plsgroup" Value="Broad" TChecked="string" @onchange="SelectGroup" @bind-Checked="SelectGroupType"></SfRadioButton>
                    </div>
                    <div class="form-group col-md-4">
                        <SfRadioButton Label="Medium Level Product Detail (2 Digits)" Name="plsgroup" Value="Medium" TChecked="string" @onchange="SelectGroup" @bind-Checked="SelectGroupType"></SfRadioButton>
                    </div>
                    <div class="form-group col-md-4">
                        <SfRadioButton Label="High Level Product Detail" Name="plsgroup" Value="High" TChecked="string" @onchange="SelectGroup" @bind-Checked="SelectGroupType"></SfRadioButton>
                    </div>
                </div>
                <br/>
                <div class="form-row">
                    <div class="bar-horizontal">
                        <div class="form-group col-md-4">
                            <SfRadioButton Label="Full Product Detail" Name="plsgroup" Value="Long" TChecked="string" @onchange="SelectGroup" @bind-Checked="SelectGroupType"></SfRadioButton>
                        </div>
                        <div class="form-group col-md-4">
                            <SfRadioButton Label="Custom Filters" Name="plsgroup" Value="Custom" TChecked="string" @onchange="SelectGroup" @bind-Checked="SelectGroupType"></SfRadioButton>
                        </div>
                    </div>
                </div>
            </div>
            </div>
    </div>


@code {
    [Parameter] public EventCallback<object> OnMessage { get; set; }
    [Parameter] public QueryModel Data { get; set; }
    [Parameter] public SavedQueryModel ReportModel { get; set; }
    
    private string SelectGroupType { get; set; }
    
    private async Task SelectGroup(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        await NotifyParent();
    }
    
    private async Task NotifyParent()
    {
        
        var delegateModel = new SelectionQueryModel
        {
            Id = "PLS",
            SelectedSourceCountries = new List<SaveQuerySourceCountriesModel>(),
            SelectedMarketCountries = new List<SaveQueryMarketCountriesModel>(),
            Selection = SelectGroupType
        };
        
        if (OnMessage.HasDelegate)
        {
            await OnMessage.InvokeAsync(delegateModel);
        }
    }
    
    protected override async void OnInitialized()
    {
        SelectGroupType = ReportModel.ProductGroupType;
    }
}